{% assign block_settings = block.settings %}

<div
  class="promo-badge spacing-style promo-badge--{{ block_settings.style }}"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {%- if block_settings.link != blank -%}
    <a
      href="{{ block_settings.link }}"
      class="promo-badge__link"
      {% if block_settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
    >
  {%- endif -%}

  <span class="promo-badge__pill">
    {%- if block_settings.icon == 'kickstarter' -%}
      <span class="promo-badge__icon" aria-hidden="true">K</span>
    {%- elsif block_settings.icon == 'indiegogo' -%}
      <span class="promo-badge__icon" aria-hidden="true">I</span>
    {%- endif -%}
    <span class="promo-badge__text">{{ block_settings.text }}</span>
  </span>

  {%- if block_settings.link != blank -%}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .promo-badge {
    display: flex;
    justify-content: center;
  }

  .promo-badge__link {
    color: inherit;
    text-decoration: none;
  }

  .promo-badge__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: rgb(29 29 31 / 44%);
    box-shadow: none;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    backdrop-filter: none;
  }

  .promo-badge__pill::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #00d26a;
    box-shadow: 0 0 18px rgb(0 210 106 / 72%);
  }

  .promo-badge--filled .promo-badge__pill {
    background: transparent;
    border-color: transparent;
    color: inherit;
  }

  .promo-badge__icon {
    display: none;
  }

  .promo-banner--has-media .promo-badge__pill {
    color: rgb(255 255 255 / 50%);
    text-shadow: 0 2px 20px rgb(0 0 0 / 34%);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Live on Kickstarter"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "kickstarter",
          "label": "Kickstarter"
        },
        {
          "value": "indiegogo",
          "label": "Indiegogo"
        }
      ],
      "default": "kickstarter"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "filled",
          "label": "Filled"
        }
      ],
      "default": "outline"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Promo badge"
    }
  ]
}
{% endschema %}
