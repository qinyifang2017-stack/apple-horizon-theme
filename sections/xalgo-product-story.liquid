{% liquid
  assign media_on_right = false
  if section.settings.media_position == 'right'
    assign media_on_right = true
  endif
%}

<section
  id="xalgo-product-story-{{ section.id }}"
  class="xalgo-product-story xalgo-product-story--{{ section.settings.tone }}{% if media_on_right %} xalgo-product-story--media-right{% endif %} color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width xalgo-product-story__shell">
    <div class="xalgo-product-story__media-wrap">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            class: 'xalgo-product-story__image',
            widths: '520, 760, 1000, 1400',
            sizes: '(min-width: 990px) 46vw, 100vw',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        <div class="xalgo-product-story__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'xalgo-product-story__placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if section.settings.callout != blank -%}
        <div class="xalgo-product-story__callout">{{ section.settings.callout }}</div>
      {%- endif -%}
    </div>

    <div class="xalgo-product-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-product-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="xalgo-product-story__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="xalgo-product-story__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="xalgo-product-story__points">
          {%- for block in section.blocks -%}
            <article class="xalgo-product-story__point" {{ block.shopify_attributes }}>
              <span class="xalgo-product-story__point-index">{{ forloop.index | prepend: '0' }}</span>
              <div>
                <h3>{{ block.settings.heading }}</h3>
                <div>{{ block.settings.text }}</div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .xalgo-product-story {
    --story-cream: var(--xalgo-cream, #FDFAF7);
    --story-rose: var(--xalgo-rose, #E8A598);
    --story-blush: var(--xalgo-rose-light, #F2DDD8);
    --story-champagne: var(--xalgo-champagne, #C9A882);
    --story-ink: var(--xalgo-text-primary, #1D1D1F);
    --story-muted: var(--xalgo-text-secondary, #6E6E73);
    background: var(--story-cream);
    color: var(--story-ink);
    overflow: hidden;
  }

  .xalgo-product-story--blush {
    background:
      radial-gradient(circle at 82% 12%, color-mix(in srgb, var(--story-blush) 70%, transparent) 0 20rem, transparent 34rem),
      linear-gradient(180deg, var(--story-cream), #fbf1eb);
  }

  .xalgo-product-story--champagne {
    background: linear-gradient(135deg, #f9f2e9 0%, #f3e7d7 100%);
  }

  .xalgo-product-story--mist {
    background: linear-gradient(135deg, #fafaf8 0%, #edf5f8 100%);
  }

  .xalgo-product-story .page-width {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-product-story__shell {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .xalgo-product-story__shell {
      grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    }

    .xalgo-product-story--media-right .xalgo-product-story__media-wrap {
      order: 2;
    }
  }

  .xalgo-product-story__media-wrap {
    position: relative;
    min-height: clamp(360px, 48vw, 620px);
    display: grid;
    place-items: center;
  }

  .xalgo-product-story__media-wrap::before {
    content: '';
    position: absolute;
    width: min(78%, 480px);
    aspect-ratio: 1;
    border-radius: 999px;
    background: color-mix(in srgb, var(--story-rose) 28%, transparent);
    filter: blur(18px);
    transform: translate(-8%, 6%);
  }

  .xalgo-product-story__image,
  .xalgo-product-story__placeholder {
    position: relative;
    width: min(100%, 560px);
    border-radius: clamp(28px, 4vw, 48px);
    box-shadow: 0 28px 80px rgb(201 168 130 / 0.22);
  }

  .xalgo-product-story__image {
    display: block;
    height: auto;
    object-fit: cover;
  }

  .xalgo-product-story__placeholder {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--story-blush) 58%, var(--story-cream));
    overflow: hidden;
  }

  .xalgo-product-story__placeholder-svg {
    width: 68%;
    color: color-mix(in srgb, var(--story-champagne) 48%, transparent);
  }

  .xalgo-product-story__callout {
    position: absolute;
    right: clamp(0rem, 4vw, 2rem);
    bottom: clamp(0.5rem, 4vw, 2.5rem);
    max-width: min(280px, 70%);
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--story-rose) 30%, transparent);
    border-radius: 22px;
    background: color-mix(in srgb, var(--story-cream) 82%, transparent);
    box-shadow: 0 18px 50px rgb(201 168 130 / 0.18);
    backdrop-filter: blur(16px);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--story-muted);
  }

  .xalgo-product-story__callout p {
    margin: 0;
  }

  .xalgo-product-story__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--story-rose);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .xalgo-product-story__heading {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 5.2rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
    color: var(--story-ink);
  }

  .xalgo-product-story__body {
    max-width: 620px;
    margin-top: 1.25rem;
    color: var(--story-muted);
    font-size: clamp(1rem, 1.45vw, 1.2rem);
    line-height: 1.72;
  }

  .xalgo-product-story__body p,
  .xalgo-product-story__point p {
    margin: 0;
  }

  .xalgo-product-story__points {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .xalgo-product-story__point {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--story-champagne) 34%, transparent);
  }

  .xalgo-product-story__point-index {
    font-variant-numeric: tabular-nums;
    color: var(--story-champagne);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .xalgo-product-story__point h3 {
    margin: 0 0 0.35rem;
    color: var(--story-ink);
    font-size: 1.08rem;
    letter-spacing: -0.01em;
  }

  .xalgo-product-story__point div {
    color: var(--story-muted);
    line-height: 1.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Story (xalgo)",
  "tag": "section",
  "class": "section-wrapper xalgo-product-story-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Smart sensing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better signals, less effort."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>xRing keeps watch quietly, turning small physiological changes into clearer daily signals.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "callout",
      "label": "Floating callout",
      "default": "<p>Continuous sensing without a screen on your wrist.</p>"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "blush", "label": "Blush" },
        { "value": "champagne", "label": "Champagne" },
        { "value": "mist", "label": "Mist" }
      ],
      "default": "blush"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "More accurate by design"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Multiple sensors work together to keep readings consistent as your day changes.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Story (xalgo)",
      "category": "Content",
      "blocks": [
        { "type": "point" },
        { "type": "point" },
        { "type": "point" }
      ]
    }
  ]
}
{% endschema %}
