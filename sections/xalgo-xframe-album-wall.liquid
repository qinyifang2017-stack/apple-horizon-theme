<section
  class="xalgo-xframe-album-wall color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width xalgo-xframe-album-wall__shell">
    <div class="xalgo-xframe-album-wall__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-xframe-album-wall__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="xalgo-xframe-album-wall__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="xalgo-xframe-album-wall__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <div class="xalgo-xframe-album-wall__note">{{ section.settings.note }}</div>
      {%- endif -%}
    </div>

    {%- assign first_block = section.blocks.first -%}
    {%- assign before_image = section.settings.before_image -%}
    {%- if before_image == blank and first_block.settings.image != blank -%}
      {%- assign before_image = first_block.settings.image -%}
    {%- endif -%}
    <div class="xalgo-xframe-album-wall__showcase" aria-label="Oil-painting transformation preview">
      <div class="xalgo-xframe-album-wall__before-after">
        <div class="xalgo-xframe-album-wall__preview xalgo-xframe-album-wall__preview--before">
          {%- if before_image != blank -%}
            {{
              before_image
              | image_url: width: 900
              | image_tag:
                class: 'xalgo-xframe-album-wall__image',
                widths: '320, 520, 760, 900',
                sizes: '(min-width: 990px) 30vw, 82vw',
                alt: before_image.alt
            }}
          {%- else -%}
            <div class="xalgo-xframe-album-wall__placeholder xalgo-xframe-album-wall__placeholder--before" aria-hidden="true"></div>
          {%- endif -%}
          <span>{{ section.settings.before_label }}</span>
        </div>
        <div class="xalgo-xframe-album-wall__preview xalgo-xframe-album-wall__preview--after">
          {%- if section.settings.after_image != blank -%}
            {{
              section.settings.after_image
              | image_url: width: 900
              | image_tag:
                class: 'xalgo-xframe-album-wall__image xalgo-xframe-album-wall__image--after',
                widths: '320, 520, 760, 900',
                sizes: '(min-width: 990px) 30vw, 82vw',
                alt: section.settings.after_image.alt
            }}
          {%- else -%}
            <div class="xalgo-xframe-album-wall__placeholder xalgo-xframe-album-wall__placeholder--after" aria-hidden="true"></div>
          {%- endif -%}
          <span>{{ section.settings.after_label }}</span>
        </div>
      </div>

      <div class="xalgo-xframe-album-wall__points">
        {%- for block in section.blocks limit: 3 -%}
          <article class="xalgo-xframe-album-wall__point" {{ block.shopify_attributes }}>
            <span>{{ block.settings.meta }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xalgo-xframe-album-wall {
    --xframe-paper: #fffaf2;
    --xframe-ink: var(--xalgo-text-primary, #1d1d1f);
    --xframe-muted: var(--xalgo-text-secondary, #6e6e73);
    --xframe-gold: var(--xalgo-champagne, #c9a882);
    --xframe-rose: var(--xalgo-rose, #e8a598);
    position: relative;
    background:
      radial-gradient(circle at 82% 18%, rgb(232 165 152 / 0.18), transparent 24rem),
      radial-gradient(circle at 18% 74%, rgb(201 168 130 / 0.16), transparent 28rem),
      linear-gradient(90deg, rgb(36 31 27 / 0.035) 1px, transparent 1px),
      linear-gradient(0deg, rgb(36 31 27 / 0.035) 1px, transparent 1px),
      linear-gradient(180deg, #fffaf2 0%, #f8efe5 100%);
    background-size: auto, auto, 44px 44px, 44px 44px, auto;
    color: var(--xframe-ink);
    overflow: hidden;
  }

  .xalgo-xframe-album-wall::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 0 46%, rgb(255 255 255 / 0.52) 46% 63%, transparent 63% 100%);
    pointer-events: none;
  }

  .xalgo-xframe-album-wall .page-width {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-xframe-album-wall__shell {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .xalgo-xframe-album-wall__shell {
      grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    }

    .xalgo-xframe-album-wall__copy {
      position: sticky;
      top: 2rem;
    }
  }

  .xalgo-xframe-album-wall__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--xframe-rose);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .xalgo-xframe-album-wall__heading {
    max-width: 9ch;
    margin: 0;
    color: var(--xframe-ink);
    font-size: clamp(2.3rem, 4.8vw, 4.7rem);
    line-height: 0.86;
    letter-spacing: -0.07em;
  }

  .xalgo-xframe-album-wall__body {
    max-width: 580px;
    margin-top: 1.3rem;
    color: var(--xframe-muted);
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.7;
  }

  .xalgo-xframe-album-wall__body p,
  .xalgo-xframe-album-wall__note p {
    margin: 0;
  }

  .xalgo-xframe-album-wall__note {
    max-width: 420px;
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--xframe-gold) 28%, transparent);
    border-radius: 20px;
    background: rgb(255 255 255 / 0.7);
    color: var(--xframe-muted);
    line-height: 1.55;
    box-shadow: 0 18px 48px rgb(91 63 37 / 0.08);
    backdrop-filter: blur(14px);
  }

  .xalgo-xframe-album-wall__showcase {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .xalgo-xframe-album-wall__showcase::before {
    content: '';
    position: absolute;
    inset: clamp(-1.2rem, -2vw, -0.8rem);
    border: 1px solid rgb(201 168 130 / 0.18);
    border-radius: clamp(32px, 5vw, 52px);
    background: rgb(255 250 242 / 0.34);
    box-shadow: 0 28px 82px rgb(91 63 37 / 0.08);
    pointer-events: none;
  }

  .xalgo-xframe-album-wall__showcase > * {
    position: relative;
    z-index: 1;
  }

  .xalgo-xframe-album-wall__before-after {
    display: grid;
    gap: 1rem;
  }

  @media screen and (min-width: 750px) {
    .xalgo-xframe-album-wall__before-after {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .xalgo-xframe-album-wall__preview {
    position: relative;
    min-height: clamp(240px, 24vw, 340px);
    overflow: hidden;
    border: 1px solid rgb(36 31 27 / 0.08);
    border-radius: clamp(24px, 4vw, 36px);
    background: rgb(255 255 255 / 0.72);
    box-shadow: 0 24px 68px rgb(91 63 37 / 0.12);
  }

  .xalgo-xframe-album-wall__preview--after {
    transform: rotate(1deg) translateY(0.7rem);
    border-color: rgb(201 168 130 / 0.28);
    box-shadow: 0 30px 82px rgb(91 63 37 / 0.16);
  }

  .xalgo-xframe-album-wall__preview span {
    position: absolute;
    left: 1rem;
    top: 1rem;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 250 242 / 0.8);
    color: var(--xframe-ink);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(14px);
  }

  .xalgo-xframe-album-wall__points {
    display: grid;
    gap: 0.8rem;
  }

  @media screen and (min-width: 750px) {
    .xalgo-xframe-album-wall__points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .xalgo-xframe-album-wall__point {
    padding: 1rem;
    border: 1px solid rgb(36 31 27 / 0.08);
    border-radius: 20px;
    background: rgb(255 255 255 / 0.62);
    box-shadow: 0 18px 46px rgb(91 63 37 / 0.08);
    backdrop-filter: blur(12px);
  }

  .xalgo-xframe-album-wall__point:nth-child(2) {
    background: rgb(255 250 242 / 0.86);
    transform: translateY(0.75rem);
  }

  .xalgo-xframe-album-wall__point:nth-child(3) {
    background: rgb(246 238 228 / 0.78);
  }

  .xalgo-xframe-album-wall__point span {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--xframe-rose);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .xalgo-xframe-album-wall__point h3 {
    margin: 0 0 0.35rem;
    color: var(--xframe-ink);
    font-size: clamp(1.08rem, 1.5vw, 1.3rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .xalgo-xframe-album-wall__point p {
    margin: 0;
    color: var(--xframe-muted);
    line-height: 1.5;
    font-size: 0.9rem;
  }

  .xalgo-xframe-album-wall__image,
  .xalgo-xframe-album-wall__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .xalgo-xframe-album-wall__placeholder {
    background:
      radial-gradient(circle at 34% 24%, rgb(232 165 152 / 0.75), transparent 27%),
      radial-gradient(circle at 78% 72%, rgb(201 168 130 / 0.66), transparent 29%),
      linear-gradient(145deg, #f8efe4, #d9ebf2);
  }

  .xalgo-xframe-album-wall__placeholder--before {
    filter: saturate(0.85) contrast(0.95);
  }

  .xalgo-xframe-album-wall__placeholder--after {
    background:
      radial-gradient(circle at 34% 24%, rgb(232 165 152 / 0.9), transparent 24%),
      radial-gradient(circle at 78% 72%, rgb(201 168 130 / 0.78), transparent 28%),
      linear-gradient(145deg, #f3d0ae, #c7dde4);
    filter: saturate(1.22) contrast(1.05);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "xFrame Album Wall",
  "tag": "section",
  "class": "section-wrapper xalgo-xframe-album-wall-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AI album organization"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let the album arrange itself."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>xFrame helps turn a messy camera roll into themed albums for people, trips, pets, holidays and daily moments — so the best photos are ready for the wall.</p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note",
      "default": "<p>AI can surface stronger images, reduce repeats, and keep the display feeling fresh without manual slideshow management.</p>"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Original photo"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "Oil-painting style"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Original photo image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Oil-painting style image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 104
    }
  ],
  "blocks": [
    {
      "type": "album",
      "name": "Album",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Family"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta",
          "default": "AI sorted"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Faces, warm expressions and everyday rituals gathered into one living album."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Memory"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "xFrame Album Wall",
      "category": "Content",
      "blocks": [
        { "type": "album" },
        { "type": "album" },
        { "type": "album" },
        { "type": "album" },
        { "type": "album" }
      ]
    }
  ]
}
{% endschema %}
