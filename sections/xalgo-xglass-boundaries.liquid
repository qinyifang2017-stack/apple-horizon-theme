<section
  class="xalgo-xglass-boundaries color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width xalgo-xglass-boundaries__shell">
    <div class="xalgo-xglass-boundaries__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-xglass-boundaries__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="xalgo-xglass-boundaries__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="xalgo-xglass-boundaries__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    <div class="xalgo-xglass-boundaries__panel">
      <div class="xalgo-xglass-boundaries__orbit" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="xalgo-xglass-boundaries__cards">
        {%- for block in section.blocks -%}
          <article class="xalgo-xglass-boundaries__card" {{ block.shopify_attributes }}>
            <span class="xalgo-xglass-boundaries__label">{{ block.settings.label }}</span>
            <h3>{{ block.settings.heading }}</h3>
            <div>{{ block.settings.text }}</div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xalgo-xglass-boundaries {
    --boundary-cream: var(--xalgo-cream, #FDFAF7);
    --boundary-rose: var(--xalgo-rose, #E8A598);
    --boundary-blush: var(--xalgo-rose-light, #F2DDD8);
    --boundary-champagne: var(--xalgo-champagne, #C9A882);
    --boundary-ink: var(--xalgo-text-primary, #1D1D1F);
    --boundary-muted: var(--xalgo-text-secondary, #6E6E73);
    background: linear-gradient(180deg, var(--boundary-ink) 0%, #252b38 100%);
    color: white;
    overflow: hidden;
  }

  .xalgo-xglass-boundaries .page-width {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-xglass-boundaries__shell {
    display: grid;
    gap: clamp(3rem, 6vw, 7rem);
  }

  @media screen and (min-width: 990px) {
    .xalgo-xglass-boundaries__shell {
      grid-template-columns: minmax(320px, 0.74fr) minmax(0, 1.26fr);
      align-items: center;
    }
  }

  .xalgo-xglass-boundaries__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--boundary-rose);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .xalgo-xglass-boundaries__heading {
    max-width: 11ch;
    margin: 0;
    color: white;
    font-size: clamp(2.6rem, 5.6vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .xalgo-xglass-boundaries__body {
    max-width: 560px;
    margin-top: 1.25rem;
    color: rgb(255 255 255 / 0.72);
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.72;
  }

  .xalgo-xglass-boundaries__body p,
  .xalgo-xglass-boundaries__card p {
    margin: 0;
  }

  .xalgo-xglass-boundaries__panel {
    position: relative;
    min-height: 560px;
    display: grid;
    place-items: center;
  }

  .xalgo-xglass-boundaries__orbit {
    position: absolute;
    inset: 50% auto auto 50%;
    width: min(70vw, 520px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    opacity: 0.62;
  }

  .xalgo-xglass-boundaries__orbit span {
    position: absolute;
    border: 1px solid rgb(232 165 152 / 0.24);
    border-radius: 999px;
  }

  .xalgo-xglass-boundaries__orbit span:nth-child(1) {
    inset: 0;
  }

  .xalgo-xglass-boundaries__orbit span:nth-child(2) {
    inset: 17%;
  }

  .xalgo-xglass-boundaries__orbit span:nth-child(3) {
    inset: 34%;
    background: radial-gradient(circle, rgb(232 165 152 / 0.16), transparent 64%);
  }

  .xalgo-xglass-boundaries__cards {
    position: relative;
    display: grid;
    gap: clamp(1.2rem, 2.4vw, 1.8rem);
    width: min(100%, 820px);
  }

  @media screen and (min-width: 750px) {
    .xalgo-xglass-boundaries__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .xalgo-xglass-boundaries__card {
    min-height: 230px;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.8rem);
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.105), rgb(255 255 255 / 0.06)),
      rgb(255 255 255 / 0.055);
    box-shadow: 0 24px 68px rgb(0 0 0 / 0.18);
    backdrop-filter: blur(18px);
  }

  .xalgo-xglass-boundaries__label {
    display: inline-flex;
    margin-bottom: 1.1rem;
    color: var(--boundary-rose);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .xalgo-xglass-boundaries__card h3 {
    margin: 0 0 0.7rem;
    color: white;
    font-size: clamp(1.25rem, 1.9vw, 1.65rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .xalgo-xglass-boundaries__card div {
    color: rgb(255 255 255 / 0.66);
    font-size: 0.95rem;
    line-height: 1.58;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "xGlass Boundaries",
  "tag": "section",
  "class": "section-wrapper xalgo-xglass-boundaries-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Privacy and responsibility"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Respect the room."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Smart glasses are worn around other people, so xGlass explains listening, recording awareness and AI responsibility as part of the product experience — not as fine print.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 104
    }
  ],
  "blocks": [
    {
      "type": "boundary",
      "name": "Boundary card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Visible listening"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Make capture understandable."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>When audio capture or transcription is active, status feedback should be clear to the wearer and easy to explain around others.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "xGlass Boundaries",
      "category": "Content",
      "blocks": [
        { "type": "boundary" },
        { "type": "boundary" },
        { "type": "boundary" },
        { "type": "boundary" }
      ]
    }
  ]
}
{% endschema %}
