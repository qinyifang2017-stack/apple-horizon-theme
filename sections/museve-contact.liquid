{% comment %}
  MUSEVE Contact page — copy and typography follow MUSEVE_Contact_Us_Reference.html.
  Desktop: support + business cards on the left, form on the right.
  Mobile: support → form → business. Company Information block removed by request.
{% endcomment %}

<section
  id="museve-contact-{{ section.id }}"
  class="museve-contact color-{{ section.settings.color_scheme }}"
  style="
    --mc-padding-top: {{ section.settings.padding_top }}px;
    --mc-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="museve-contact__shell">
    <header class="museve-contact__hero">
      <p class="museve-contact__eyebrow">Contact MUSEVE</p>
      <h1 class="museve-contact__title">How can we help?</h1>
      <p class="museve-contact__lede">
        Need help or want to work with us? Get in touch below.
      </p>
    </header>

    <div class="museve-contact__grid">
      <div class="museve-contact__routes">
        <article class="museve-contact__card museve-contact__support">
          <p class="museve-contact__eyebrow">Customer support</p>
          <h2>Product &amp; order support</h2>
          <p class="museve-contact__card-copy">
            For help with products, orders, or warranty questions, email our support team.
          </p>
          <a class="museve-contact__email-link" href="mailto:{{ section.settings.support_email | escape }}">
            {{ section.settings.support_email }}
            <span class="museve-contact__arrow" aria-hidden="true">↗</span>
          </a>
          <div class="museve-contact__quick-answer">
            <h3>Looking for a quick answer?</h3>
            <p>For common questions, visit our FAQs.</p>
            <a class="museve-contact__text-link" href="{{ section.settings.faq_url | default: '/pages/faq' }}">
              View FAQs
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <article class="museve-contact__card museve-contact__business">
          <p class="museve-contact__eyebrow">Business &amp; partnerships</p>
          <h2>Work with MUSEVE</h2>
          <p class="museve-contact__card-copy">
            For retail and distribution opportunities, media inquiries, or other business
            questions, email our team.
          </p>
          <a class="museve-contact__email-link" href="mailto:{{ section.settings.business_email | escape }}">
            {{ section.settings.business_email }}
            <span class="museve-contact__arrow" aria-hidden="true">↗</span>
          </a>
        </article>
      </div>

      <div class="museve-contact__card museve-contact__form-card">
        <h2 class="museve-contact__form-title">Send us a message</h2>
        <p class="museve-contact__form-intro">Choose a topic and tell us how we can help.</p>

        {% assign form_id = section.id | prepend: 'MUSEVEContactForm-' %}
        {%- form 'contact', id: form_id, class: 'museve-contact__form', novalidate: 'novalidate' -%}
          <input name="contact[id]" type="hidden" value="{{ form_id }}">

          {%- if form.errors and form.id == form_id -%}
            <div
              class="museve-contact__notice museve-contact__notice--error"
              tabindex="-1"
              autofocus
            >
              {{- 'icon-error.svg' | inline_asset_content -}}
              <span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? and form.id == form_id -%}
            <div
              class="museve-contact__notice museve-contact__notice--success"
              tabindex="-1"
              autofocus
            >
              {{- 'icon-checkmark.svg' | inline_asset_content -}}
              <span>Thanks for reaching out. We&rsquo;ll reply to the email address you provided.</span>
            </div>
          {%- endif -%}

          <div class="museve-contact__field museve-contact__field--full">
            <label for="MUSEVEContact-topic-{{ section.id }}">Topic <span aria-hidden="true">*</span></label>
            <select id="MUSEVEContact-topic-{{ section.id }}" name="contact[topic]" required>
              <option value="" disabled selected>Select a topic</option>
              <option value="Product questions">Product questions</option>
              <option value="Orders &amp; shipping">Orders &amp; shipping</option>
              <option value="Returns &amp; refunds">Returns &amp; refunds</option>
              <option value="Technical support &amp; warranty">Technical support &amp; warranty</option>
              <option value="Business &amp; media inquiries">Business &amp; media inquiries</option>
              <option value="Other">Other</option>
            </select>
            <p class="museve-contact__field-error" data-error-for="topic" hidden></p>
          </div>

          <div class="museve-contact__fields">
            <div class="museve-contact__field">
              <label for="MUSEVEContact-name-{{ section.id }}">Name <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="MUSEVEContact-name-{{ section.id }}"
                name="contact[name]"
                autocomplete="name"
                required
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              >
              <p class="museve-contact__field-error" data-error-for="name" hidden></p>
            </div>

            <div class="museve-contact__field">
              <label for="MUSEVEContact-email-{{ section.id }}">Email address <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="MUSEVEContact-email-{{ section.id }}"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                aria-required="true"
                required
                {% if form.errors contains 'email' and form.id == form_id %}
                  aria-invalid="true"
                {% endif %}
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              >
              <p class="museve-contact__field-error" data-error-for="email" hidden></p>
            </div>
          </div>

          <div class="museve-contact__field museve-contact__field--full museve-contact__conditional" data-show-for="Orders &amp; shipping,Returns &amp; refunds,Technical support &amp; warranty" hidden>
            <label for="MUSEVEContact-order-{{ section.id }}">
              Order number
            </label>
            <input
              type="text"
              id="MUSEVEContact-order-{{ section.id }}"
              name="contact[Order number]"
              disabled
            >
            <p class="museve-contact__field-help">
              You can find this in your order confirmation email.
            </p>
          </div>

          <div class="museve-contact__field museve-contact__field--full">
            <label for="MUSEVEContact-body-{{ section.id }}">Message <span aria-hidden="true">*</span></label>
            <textarea
              rows="6"
              id="MUSEVEContact-body-{{ section.id }}"
              name="contact[body]"
              required
              placeholder="Tell us how we can help."
            >{{- form.body -}}</textarea>
            <p class="museve-contact__field-error" data-error-for="body" hidden></p>
          </div>

          <div class="museve-contact__form-bottom">
            <button class="museve-contact__send" type="submit">Send message</button>
            {%- if shop.privacy_policy_url -%}
              <a class="museve-contact__privacy-link" href="{{ shop.privacy_policy_url }}" target="_blank" rel="noopener">
                Privacy Policy
              </a>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('museve-contact-{{ section.id }}');
    if (!section) return;

    var form = section.querySelector('.museve-contact__form');
    if (!form) return;

    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    var fields = [
      { key: 'topic', el: form.querySelector('[name="contact[topic]"]'), message: 'Please select a topic.' },
      { key: 'name', el: form.querySelector('[name="contact[name]"]'), message: 'Please enter your name.' },
      { key: 'email', el: form.querySelector('[name="contact[email]"]'), message: 'Please enter a valid email address.' },
      { key: 'body', el: form.querySelector('[name="contact[body]"]'), message: 'Please enter a message.' }
    ];

    function setError(field, message) {
      var box = section.querySelector('[data-error-for="' + field.key + '"]');
      if (!box) return;
      if (message) {
        box.textContent = message;
        box.hidden = false;
        field.el.setAttribute('aria-invalid', 'true');
        field.el.classList.add('is-invalid');
      } else {
        box.textContent = '';
        box.hidden = true;
        field.el.removeAttribute('aria-invalid');
        field.el.classList.remove('is-invalid');
      }
    }

    function validate(field) {
      var value = (field.el.value || '').trim();
      if (!value) return field.message;
      if (field.key === 'email' && !EMAIL_RE.test(value)) return field.message;
      return '';
    }

    form.addEventListener('submit', function (event) {
      var firstInvalid = null;
      fields.forEach(function (field) {
        if (!field.el) return;
        var message = validate(field);
        setError(field, message);
        if (message && !firstInvalid) firstInvalid = field.el;
      });
      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
      }
    });

    fields.forEach(function (field) {
      if (!field.el) return;
      field.el.addEventListener('input', function () {
        if (field.el.classList.contains('is-invalid')) setError(field, validate(field));
      });
      field.el.addEventListener('change', function () {
        if (field.el.classList.contains('is-invalid')) setError(field, validate(field));
      });
    });

    /* Order number shows only for order-related topics; hidden inputs are disabled so they are not submitted */
    var topicEl = form.querySelector('[name="contact[topic]"]');
    var conditionalFields = Array.prototype.slice.call(form.querySelectorAll('.museve-contact__conditional'));

    function syncConditionalFields() {
      var topic = topicEl ? topicEl.value : '';
      conditionalFields.forEach(function (wrap) {
        var showFor = (wrap.getAttribute('data-show-for') || '').split(',');
        var show = showFor.indexOf(topic) > -1;
        wrap.hidden = !show;
        var input = wrap.querySelector('input, select, textarea');
        if (input) input.disabled = !show;
      });
    }

    if (topicEl && conditionalFields.length) {
      topicEl.addEventListener('change', syncConditionalFields);
      syncConditionalFields();
    }
  })();
</script>

{% stylesheet %}
  .museve-contact {
    --mc-paper: #fcf9f6;
    --mc-white: #ffffff;
    --mc-ink: #252522;
    --mc-muted: #696661;
    --mc-gold: #88724d;
    --mc-rose: #a35e50;
    --mc-rose-hover: #884c41;
    --mc-rule: #e8e1d9;
    --mc-field: #f7f3ef;

    background: var(--mc-paper);
    color: var(--mc-ink);
    font-family: Arial, Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    -webkit-font-smoothing: antialiased;
    padding-block: var(--mc-padding-top) var(--mc-padding-bottom);
  }

  .museve-contact *,
  .museve-contact *::before,
  .museve-contact *::after {
    box-sizing: border-box;
  }

  /* 主题 base.css 的字体预设会渗入 h1/h2/h3，统一复位为参考稿样式 */
  .museve-contact,
  .museve-contact :is(p, h1, h2, h3, label, a, span) {
    font-family: Arial, Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }

  .museve-contact :is(h1, h2, h3) {
    margin: 0;
    font-style: normal;
    text-transform: none;
    color: var(--mc-ink);
  }

  .museve-contact__shell {
    width: min(1440px, calc(100% - 72px));
    margin-inline: auto;
    padding-block: 56px 60px;
  }

  .museve-contact__eyebrow {
    color: var(--mc-gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* —— Hero —— */
  .museve-contact__hero {
    margin-bottom: 56px;
  }

  .museve-contact__title {
    margin: 14px 0 20px;
    font-size: clamp(42px, 4.6vw, 66px);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.07;
  }

  .museve-contact__lede {
    max-width: 590px;
    color: var(--mc-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  /* —— Grid：左客服+商务，右表单 —— */
  .museve-contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.2fr);
    grid-template-areas: 'routes form';
    gap: 22px;
    align-items: start;
  }

  .museve-contact__routes {
    grid-area: routes;
    display: grid;
    gap: 22px;
  }

  /* 隐藏的条件字段必须彻底移除，不占网格空间 */
  .museve-contact [hidden] {
    display: none !important;
  }

  .museve-contact__card {
    padding: 30px;
    border: 1px solid var(--mc-rule);
    border-radius: 15px;
    background: var(--mc-white);
  }

  .museve-contact__card h2 {
    margin: 11px 0 13px;
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .museve-contact__card-copy {
    color: var(--mc-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .museve-contact__email-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 7px;
    padding: 12px 0;
    color: var(--mc-rose);
    font-size: 16px;
    font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .museve-contact__email-link:hover {
    text-decoration: underline;
  }

  .museve-contact__arrow {
    font-size: 19px;
    font-weight: 400;
  }

  .museve-contact__quick-answer {
    margin-top: 17px;
    padding-top: 22px;
    border-top: 1px solid var(--mc-rule);
  }

  .museve-contact__quick-answer h3 {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .museve-contact__quick-answer p {
    margin: 7px 0;
    color: var(--mc-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .museve-contact__text-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 38px;
    color: var(--mc-ink);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .museve-contact__text-link:hover {
    text-decoration: underline;
  }

  /* —— Form —— */
  .museve-contact__form-card {
    grid-area: form;
    padding: 34px;
    box-shadow: 0 12px 36px rgb(120 105 77 / 2.4%);
  }

  .museve-contact__form-card h2 {
    margin: 11px 0 13px;
    font-size: 30px;
  }

  .museve-contact__form-intro {
    color: var(--mc-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .museve-contact__form {
    display: grid;
    gap: 19px;
    margin-top: 22px;
  }

  .museve-contact__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 19px 16px;
  }

  .museve-contact__field {
    min-width: 0;
  }

  .museve-contact__field--full {
    grid-column: 1 / -1;
  }

  .museve-contact__field label {
    display: block;
    margin-bottom: 8px;
    color: var(--mc-ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
  }

  /* 必填星号：更大更醒目，一眼识别 */
  .museve-contact__field label > span[aria-hidden='true'] {
    color: var(--mc-rose);
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
  }

  .museve-contact__field-help {
    margin-top: 7px;
    color: var(--mc-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .museve-contact__field input,
  .museve-contact__field select,
  .museve-contact__field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    background: var(--mc-field);
    border: 1px solid #dcd4cb;
    border-radius: 9px;
    color: var(--mc-ink);
    font: inherit;
    font-size: 16px;
  }

  .museve-contact__field input::placeholder,
  .museve-contact__field textarea::placeholder {
    color: #76716b;
    opacity: 1;
  }

  .museve-contact__field select {
    appearance: none;
    -webkit-appearance: none;
    height: 48px;
    padding-right: 40px;
    background-image:
      linear-gradient(45deg, transparent 50%, #696661 50%),
      linear-gradient(135deg, #696661 50%, transparent 50%);
    background-position:
      calc(100% - 19px) 21px,
      calc(100% - 14px) 21px;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }

  .museve-contact__field textarea {
    min-height: 146px;
    line-height: 1.6;
    resize: vertical;
  }

  .museve-contact__field :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--mc-rose);
    outline-offset: 4px;
  }

  .museve-contact__field-error {
    margin: 7px 0 0;
    color: #a02f27;
    font-size: 12px;
    line-height: 1.5;
  }

  .museve-contact__field :is(input, select, textarea)[aria-invalid='true'] {
    border-color: #b33a30;
    background-color: #fff9f8;
  }

  .museve-contact__form-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 3px;
  }

  .museve-contact__send {
    min-height: 48px;
    padding: 13px 26px;
    border: 0;
    border-radius: 99px;
    background: var(--mc-rose);
    color: white;
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .museve-contact__send:hover {
    background: var(--mc-rose-hover);
  }

  .museve-contact__privacy-link {
    color: var(--mc-muted);
    font-size: 12px;
  }

  .museve-contact__notice {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px;
    border: 1px solid #d4ded1;
    border-radius: 9px;
    background: #f3f7f1;
    font-size: 14px;
    line-height: 1.65;
  }

  .museve-contact__notice svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .museve-contact__notice--error {
    background: #fff6f3;
    border-color: #e8c4bc;
    color: #a02f27;
  }

  .museve-contact__notice--success {
    color: var(--mc-ink);
  }

  /* —— 移动端：客服 → 表单 → 商务 —— */
  @media screen and (max-width: 900px) {
    .museve-contact__shell {
      width: calc(100% - 40px);
      padding-block: 34px 36px;
    }

    .museve-contact__hero {
      margin-bottom: 26px;
    }

    .museve-contact__title {
      font-size: 44px;
      margin: 12px 0 17px;
    }

    .museve-contact__lede {
      font-size: 15px;
    }

    .museve-contact__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'routes'
        'form';
      gap: 18px;
    }

    .museve-contact__form-card {
      order: 1;
    }

    .museve-contact__business {
      order: 2;
    }

    .museve-contact__card,
    .museve-contact__form-card {
      padding: 24px;
      border-radius: 13px;
    }

    .museve-contact__card h2 {
      font-size: 26px;
    }
  }

  @media screen and (max-width: 460px) {
    .museve-contact__title {
      font-size: 41px;
    }

    .museve-contact__fields {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .museve-contact__card,
    .museve-contact__form-card {
      padding: 23px;
    }

    .museve-contact__form-bottom {
      gap: 16px;
    }

    .museve-contact__send {
      width: 100%;
    }

    .museve-contact__privacy-link {
      margin: 0 auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact (MUSEVE)",
  "tag": "section",
  "class": "section-wrapper museve-contact-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@museve.com"
    },
    {
      "type": "text",
      "id": "business_email",
      "label": "Business email",
      "default": "business@museve.com"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "FAQs link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Contact (MUSEVE)",
      "category": "Forms"
    }
  ]
}
{% endschema %}
