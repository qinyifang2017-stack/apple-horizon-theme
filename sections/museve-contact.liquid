{% comment %}
  MUSEVE Contact page: a complete contact destination with routing, a Shopify
  contact form, and company information managed from section settings.
{% endcomment %}

<section
  id="museve-contact-{{ section.id }}"
  class="museve-contact color-{{ section.settings.color_scheme }}"
  style="
    --mc-padding-top: {{ section.settings.padding_top }}px;
    --mc-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="museve-contact__shell">
    <header class="museve-contact__hero">
      <p class="museve-contact__eyebrow">Contact MUSEVE</p>
      <h1 class="museve-contact__title">Tell us what you need next.</h1>
      <p class="museve-contact__lede">
        Whether you have a product question, need support, or want to discuss business
        opportunities, our team is here to help.
      </p>
    </header>

    <div class="museve-contact__workspace">
      <aside class="museve-contact__routes" aria-label="Contact options">
        <article class="museve-contact__route">
          <p class="museve-contact__route-label">Customer Support</p>
          <h2>Product questions and after-sales help.</h2>
          <p>
            For product questions, order assistance, warranty, or after-sales support, contact our
            support team.
          </p>
          <a href="mailto:{{ section.settings.support_email | escape }}">
            {{ section.settings.support_email }}
          </a>
        </article>

        <article class="museve-contact__route">
          <p class="museve-contact__route-label">Business &amp; Partnerships</p>
          <h2>Distribution, retail, media, and collaboration.</h2>
          <p>
            For partnership opportunities, media inquiries, channel discussions, or general business
            communication, email our business team.
          </p>
          <a href="mailto:{{ section.settings.business_email | escape }}">
            {{ section.settings.business_email }}
          </a>
        </article>
      </aside>

      <div class="museve-contact__form-panel">
        <div class="museve-contact__form-heading">
          <p class="museve-contact__route-label">Send a Message</p>
          <h2>Use the form and we will route it to the right team.</h2>
        </div>

        {% assign form_id = section.id | prepend: 'MUSEVEContactForm-' %}
        {%- form 'contact', id: form_id, class: 'museve-contact__form' -%}
          <input name="contact[id]" type="hidden" value="{{ form_id }}">

          {%- if form.errors and form.id == form_id -%}
            <div
              class="museve-contact__notice museve-contact__notice--error"
              tabindex="-1"
              autofocus
            >
              {{- 'icon-error.svg' | inline_asset_content -}}
              <span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? and form.id == form_id -%}
            <div
              class="museve-contact__notice museve-contact__notice--success"
              tabindex="-1"
              autofocus
            >
              {{- 'icon-checkmark.svg' | inline_asset_content -}}
              <span>{{ 'blocks.contact_form.post_success' | t }}</span>
            </div>
          {%- endif -%}

          <div class="museve-contact__fields museve-contact__fields--two">
            <div class="museve-contact__field">
              <label for="MUSEVEContact-name-{{ section.id }}">Name</label>
              <input
                type="text"
                id="MUSEVEContact-name-{{ section.id }}"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Your name"
              >
            </div>

            <div class="museve-contact__field">
              <label for="MUSEVEContact-email-{{ section.id }}"
                >Email <span aria-hidden="true">*</span></label
              >
              <input
                type="email"
                id="MUSEVEContact-email-{{ section.id }}"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                required
                {% if form.errors contains 'email' and form.id == form_id %}
                  aria-invalid="true"
                {% endif %}
                placeholder="you@example.com"
              >
            </div>
          </div>

          <div class="museve-contact__fields museve-contact__fields--two">
            <div class="museve-contact__field">
              <label for="MUSEVEContact-topic-{{ section.id }}">Topic</label>
              <select id="MUSEVEContact-topic-{{ section.id }}" name="contact[topic]">
                <option value="Product support">Product support</option>
                <option value="Order assistance">Order assistance</option>
                <option value="Warranty or after-sales">Warranty or after-sales</option>
                <option value="Business partnership">Business partnership</option>
                <option value="Media inquiry">Media inquiry</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="museve-contact__field">
              <label for="MUSEVEContact-phone-{{ section.id }}">Phone</label>
              <input
                type="tel"
                id="MUSEVEContact-phone-{{ section.id }}"
                name="contact[phone]"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="Optional"
              >
            </div>
          </div>

          <div class="museve-contact__field">
            <label for="MUSEVEContact-body-{{ section.id }}">Message</label>
            <textarea
              rows="7"
              id="MUSEVEContact-body-{{ section.id }}"
              name="contact[body]"
              placeholder="Share a few details so we can help faster."
            >{{- form.body -}}</textarea>
          </div>

          <button class="button museve-contact__submit" type="submit">Send message</button>
        {%- endform -%}
      </div>
    </div>

    <div class="museve-contact__company" aria-label="Company information">
      <div>
        <p class="museve-contact__eyebrow">Company Information</p>
        <h2>Operated by {{ section.settings.trade_name }}</h2>
      </div>
      <dl class="museve-contact__details">
        <div>
          <dt>Trade name</dt>
          <dd>{{ section.settings.trade_name }}</dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd>
            <a href="tel:{{ section.settings.phone | remove: '-' | escape }}">
              {{- section.settings.phone -}}
            </a>
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd>
            <a href="mailto:{{ section.settings.support_email | escape }}">
              {{- section.settings.support_email -}}
            </a>
          </dd>
        </div>
        <div>
          <dt>Address</dt>
          <dd>{{ section.settings.address }}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

{% stylesheet %}
  .museve-contact {
    --mc-ink: var(--xalgo-text-primary, #1d1d1f);
    --mc-muted: #6e6e73;
    --mc-soft: #f5f0eb;
    --mc-panel: #ffffff;
    --mc-line: #e5ddd3;
    --mc-accent: var(--xalgo-champagne, #c9a882);
    --mc-accent-soft: #f2e9dc;
    --mc-focus: #b06557;
    --mc-link: #b06557;

    background: var(--xalgo-cream, #fdfaf7);
    color: var(--mc-ink);
    font-family: var(--font-body--family, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif);
    padding-block: var(--mc-padding-top) var(--mc-padding-bottom);
  }

  .museve-contact * {
    box-sizing: border-box;
  }

  .museve-contact__shell {
    width: min(1160px, calc(100% - 32px));
    margin-inline: auto;
  }

  .museve-contact__hero {
    max-width: 790px;
    padding-block: clamp(56px, 8vw, 112px) clamp(34px, 5vw, 64px);
  }

  .museve-contact__eyebrow,
  .museve-contact__route-label {
    margin: 0;
    color: var(--mc-accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .museve-contact__title {
    max-width: 720px;
    margin: 12px 0 0;
    color: var(--mc-ink);
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(3rem, 7.2vw, 6.6rem);
    font-weight: 680;
    line-height: 0.96;
    letter-spacing: -0.02em;
  }

  .museve-contact__lede {
    max-width: 650px;
    margin: 28px 0 0;
    color: var(--mc-muted);
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    line-height: 1.55;
  }

  .museve-contact__workspace {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(22px, 4vw, 48px);
    align-items: start;
  }

  .museve-contact__routes {
    display: grid;
    gap: 14px;
  }

  .museve-contact__route,
  .museve-contact__form-panel,
  .museve-contact__company {
    border: 1px solid var(--mc-line);
    border-radius: 14px;
    background: var(--mc-panel);
  }

  .museve-contact__route {
    padding: clamp(22px, 3vw, 30px);
  }

  .museve-contact__route h2,
  .museve-contact__form-heading h2,
  .museve-contact__company h2 {
    margin: 10px 0 0;
    color: var(--mc-ink);
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .museve-contact__route p:not(.museve-contact__route-label) {
    margin: 16px 0 0;
    color: var(--mc-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .museve-contact__route a,
  .museve-contact__details a {
    color: var(--mc-link);
    text-decoration: none;
  }

  .museve-contact__route a {
    display: inline-flex;
    margin-block-start: 18px;
    font-weight: 650;
  }

  .museve-contact__route a:hover,
  .museve-contact__details a:hover {
    text-decoration: underline;
  }

  .museve-contact__form-panel {
    padding: clamp(24px, 4vw, 42px);
    box-shadow: 0 24px 80px rgba(29, 29, 31, 0.06);
  }

  .museve-contact__form-heading {
    max-width: 520px;
    margin-block-end: 28px;
  }

  .museve-contact__form {
    display: grid;
    gap: 18px;
  }

  .museve-contact__fields {
    display: grid;
    gap: 16px;
  }

  .museve-contact__fields--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .museve-contact__field {
    display: grid;
    gap: 8px;
  }

  .museve-contact__field label {
    color: var(--mc-ink);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .museve-contact__field input,
  .museve-contact__field select,
  .museve-contact__field textarea {
    width: 100%;
    border: 1px solid var(--mc-line);
    border-radius: 14px;
    background: var(--mc-soft);
    color: var(--mc-ink);
    font: inherit;
    font-size: 1rem;
    padding: 14px 15px;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .museve-contact__field textarea {
    min-height: 160px;
    resize: vertical;
  }

  .museve-contact__field input:focus,
  .museve-contact__field select:focus,
  .museve-contact__field textarea:focus {
    outline: 0;
    border-color: var(--mc-focus);
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(176, 101, 87, 0.14);
  }

  .museve-contact__submit {
    width: fit-content;
    margin-block-start: 4px;
  }

  .museve-contact__notice {
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 0.95rem;
  }

  .museve-contact__notice svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .museve-contact__notice--error {
    background: #fff2f0;
    color: #9f1d16;
  }

  .museve-contact__notice--success {
    background: #eef8f0;
    color: #176c2c;
  }

  .museve-contact__company {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(26px, 5vw, 72px);
    margin-block: clamp(28px, 5vw, 64px) clamp(56px, 8vw, 104px);
    padding: clamp(24px, 4vw, 42px);
  }

  .museve-contact__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 34px;
    margin: 0;
  }

  .museve-contact__details div {
    min-width: 0;
  }

  .museve-contact__details dt {
    margin: 0 0 7px;
    color: var(--mc-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .museve-contact__details dd {
    margin: 0;
    color: var(--mc-ink);
    font-size: 1rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 900px) {
    .museve-contact__workspace,
    .museve-contact__company {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    .museve-contact__shell {
      width: min(100% - 24px, 1160px);
    }

    .museve-contact__fields--two,
    .museve-contact__details {
      grid-template-columns: 1fr;
    }

    .museve-contact__hero {
      padding-block-start: 44px;
    }

    .museve-contact__submit {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact (MUSEVE)",
  "tag": "section",
  "class": "section-wrapper museve-contact-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@museve.com"
    },
    {
      "type": "text",
      "id": "business_email",
      "label": "Business email",
      "default": "business@museve.com"
    },
    {
      "type": "text",
      "id": "trade_name",
      "label": "Trade name",
      "default": "Shenzhen Xinguodu JiSuan Technology Co., Ltd"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "0755-86593576"
    },
    {
      "type": "inline_richtext",
      "id": "address",
      "label": "Physical address",
      "default": "JLPAL, 6/F, Keji Nan 12th Road, Shenzhen, Guangdong 518000, China"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Contact (MUSEVE)",
      "category": "Forms"
    }
  ]
}
{% endschema %}
