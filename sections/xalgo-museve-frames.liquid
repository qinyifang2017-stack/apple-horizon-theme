{% comment %}
  MUSEVE Frames — "Real glasses first"
  Split: copy + numbered points + shape/colorway chips left, media with glass callout right.
  Background is a mist gradient; the section paints itself.
{% endcomment %}

{% liquid
  assign points = section.blocks | where: 'type', 'point'
  assign shapes = section.blocks | where: 'type', 'shape'
  assign any_frame_colors = false
  assign any_temple_colors = false
  for blk in section.blocks
    if blk.type == 'colorway'
      if blk.settings.group == 'frame'
        assign any_frame_colors = true
      else
        assign any_temple_colors = true
      endif
    endif
  endfor
  assign any_colors = false
  if any_frame_colors or any_temple_colors
    assign any_colors = true
  endif
%}

<section
  id="xalgo-museve-frames-{{ section.id }}"
  class="xalgo-museve-frames color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width xalgo-museve-frames__shell">
    <div class="xalgo-museve-frames__split">
      <div class="xalgo-museve-frames__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="xalgo-museve-frames__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="xalgo-museve-frames__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="xalgo-museve-frames__lede">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if points.size > 0 -%}
          <div class="xalgo-museve-frames__points">
            {%- for block in points -%}
              <div class="xalgo-museve-frames__point" {{ block.shopify_attributes }}>
                <span class="xalgo-museve-frames__point-i">{{ block.settings.number }}</span>
                <div>
                  <h3>{{ block.settings.heading }}</h3>
                  <p>{{ block.settings.text }}</p>

                  {%- if block.settings.show_shapes and shapes.size > 0 -%}
                    <div class="xalgo-museve-frames__shapes">
                      {%- for shape in shapes -%}
                        <span class="xalgo-museve-frames__shape">
                          {%- if shape.settings.thumbnail != blank -%}
                            {{ shape.settings.thumbnail | image_url: width: 88 | image_tag: width: 44, alt: '' }}
                          {%- else -%}
                            <span class="xalgo-museve-frames__shape-ph" aria-hidden="true"></span>
                          {%- endif -%}
                          {{ shape.settings.name }}
                        </span>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.show_colors and any_colors -%}
                    {%- if any_frame_colors -%}
                      <div class="xalgo-museve-frames__cgroup">
                        <span class="xalgo-museve-frames__clabel">{{ section.settings.frame_colors_label }}</span>
                        <div class="xalgo-museve-frames__cchips">
                          {%- for color in section.blocks -%}
                            {%- if color.type == 'colorway' and color.settings.group == 'frame' -%}
                              <span
                                class="xalgo-museve-frames__cchip{% if color.settings.to_be_announced %} xalgo-museve-frames__cchip--tbd{% endif %}"
                                {{ color.shopify_attributes }}
                              >
                                <i
                                  class="xalgo-museve-frames__sw{% if color.settings.to_be_announced %} xalgo-museve-frames__sw--tbd{% endif %}"
                                  {% unless color.settings.to_be_announced %}style="background: {{ color.settings.swatch }}"{% endunless %}
                                ></i>
                                {{ color.settings.name }}
                              </span>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                    {%- if any_temple_colors -%}
                      <div class="xalgo-museve-frames__cgroup">
                        <span class="xalgo-museve-frames__clabel">{{ section.settings.temple_finishes_label }}</span>
                        <div class="xalgo-museve-frames__cchips">
                          {%- for color in section.blocks -%}
                            {%- if color.type == 'colorway' and color.settings.group == 'temple' -%}
                              <span
                                class="xalgo-museve-frames__cchip{% if color.settings.to_be_announced %} xalgo-museve-frames__cchip--tbd{% endif %}"
                                {{ color.shopify_attributes }}
                              >
                                <i
                                  class="xalgo-museve-frames__sw{% if color.settings.to_be_announced %} xalgo-museve-frames__sw--tbd{% endif %}"
                                  {% unless color.settings.to_be_announced %}style="background: {{ color.settings.swatch }}"{% endunless %}
                                ></i>
                                {{ color.settings.name }}
                              </span>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="xalgo-museve-frames__media-wrap">
        <div class="xalgo-museve-frames__media-card">
          {%- if section.settings.media_type == 'video' and section.settings.frames_video != blank -%}
            {{
              section.settings.frames_video
              | video_tag:
                poster: section.settings.frames_video.preview_image,
                autoplay: true,
                loop: true,
                controls: false,
                muted: true,
                class: 'xalgo-museve-frames__media'
            }}
          {%- elsif section.settings.frames_image != blank -%}
            {{
              section.settings.frames_image
              | image_url: width: 1200
              | image_tag:
                class: 'xalgo-museve-frames__media',
                widths: '600, 900, 1200',
                sizes: '(min-width: 990px) 46vw, 100vw',
                alt: section.settings.frames_image.alt
            }}
          {%- else -%}
            <svg class="xalgo-museve-frames__placeholder" viewBox="0 0 240 110" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M18 42h84M138 42h84"/>
              <path d="M22 42v18a24 24 0 0 0 24 24h30a24 24 0 0 0 24-24V42M142 42v18a24 24 0 0 0 24 24h30a24 24 0 0 0 24-24V42"/>
              <path d="M102 50c6-6 12-6 18 0"/>
              <path d="M4 34l14 8M236 34l-14 8"/>
            </svg>
          {%- endif -%}
        </div>
        {%- if section.settings.callout_text != blank -%}
          <div class="xalgo-museve-frames__callout">{{ section.settings.callout_text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xalgo-museve-frames {
    --mf-ink: var(--xalgo-text-primary, #1d1d1f);
    --mf-muted: var(--xalgo-text-secondary, #6e6e73);
    --mf-rose: var(--xalgo-rose, #e8a598);
    --mf-terracotta: var(--xalgo-terracotta, #b06557);
    --mf-champagne: var(--xalgo-champagne, #c9a882);
    --mf-gold: var(--xalgo-gold-deep, #a87c4f);

    background: linear-gradient(135deg, #fafaf8, #edf5f8);
    color: var(--mf-ink);
  }

  .xalgo-museve-frames__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  @media (min-width: 990px) {
    .xalgo-museve-frames__split { grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr); }
  }

  .xalgo-museve-frames__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--mf-terracotta);
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-style: normal;
  }

  .xalgo-museve-frames__heading {
    margin: 0;
    font-size: clamp(2.2rem, 4.2vw, 3.9rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
    font-style: normal;
    text-transform: none;
    color: var(--mf-ink);
    max-width: 20ch;
    text-wrap: balance;
  }

  .xalgo-museve-frames__lede {
    margin-top: 1.25rem;
    max-width: 560px;
    color: var(--mf-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.7;
  }

  .xalgo-museve-frames__points {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .xalgo-museve-frames__point {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(201 168 130 / 0.34);
  }

  .xalgo-museve-frames__point-i {
    font-variant-numeric: tabular-nums;
    color: var(--mf-champagne);
    font-weight: 700;
  }

  .xalgo-museve-frames__point h3 {
    margin: 0 0 0.35rem;
    font-size: 1.06rem;
    font-weight: 700;
    font-style: normal;
    text-transform: none;
    color: var(--mf-ink);
  }

  .xalgo-museve-frames__point p {
    color: var(--mf-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .xalgo-museve-frames__shapes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .xalgo-museve-frames__shape {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem 0.35rem 0.5rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgb(29 29 31 / 0.08);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--mf-ink);
  }

  .xalgo-museve-frames__shape img {
    width: 44px;
    height: auto;
    display: block;
  }

  .xalgo-museve-frames__shape-ph {
    width: 44px;
    height: 22px;
    border-radius: 999px;
    border: 1.5px dashed rgb(29 29 31 / 0.25);
    display: inline-block;
  }

  .xalgo-museve-frames__cgroup { margin-top: 0.9rem; }

  .xalgo-museve-frames__clabel {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mf-muted);
  }

  .xalgo-museve-frames__cchips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .xalgo-museve-frames__cchip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.75rem 0.3rem 0.35rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgb(29 29 31 / 0.08);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--mf-ink);
  }

  .xalgo-museve-frames__cchip--tbd {
    color: var(--mf-muted);
    border-style: dashed;
  }

  .xalgo-museve-frames__sw {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08), 0 2px 6px rgb(0 0 0 / 0.12);
    display: inline-block;
  }

  .xalgo-museve-frames__sw--tbd {
    background: transparent;
    box-shadow: none;
    border: 1.5px dashed rgb(29 29 31 / 0.25);
  }

  .xalgo-museve-frames__media-wrap {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(340px, 44vw, 560px);
  }

  .xalgo-museve-frames__media-wrap::before {
    content: '';
    position: absolute;
    width: min(78%, 460px);
    aspect-ratio: 1;
    border-radius: 999px;
    background: rgb(232 165 152 / 0.28);
    filter: blur(18px);
    transform: translate(-8%, 6%);
  }

  .xalgo-museve-frames__media-card {
    position: relative;
    width: min(100%, 560px);
    aspect-ratio: 4 / 3;
    border-radius: clamp(28px, 4vw, 48px);
    overflow: hidden;
    box-shadow: 0 28px 80px rgb(201 168 130 / 0.22);
    display: grid;
    place-items: center;
    border: 1.5px dashed color-mix(in srgb, var(--mf-champagne) 70%, transparent);
    background: color-mix(in srgb, var(--xalgo-rose-light, #f2ddd8) 40%, var(--xalgo-cream, #fdfaf7));
    color: color-mix(in srgb, var(--mf-gold) 70%, transparent);
  }

  .xalgo-museve-frames__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .xalgo-museve-frames__placeholder {
    width: 62%;
    max-width: 420px;
  }

  .xalgo-museve-frames__callout {
    position: absolute;
    right: clamp(0rem, 3vw, 1.5rem);
    bottom: clamp(0.5rem, 3vw, 2rem);
    max-width: min(270px, 70%);
    padding: 0.9rem 1.05rem;
    border: 1px solid rgb(232 165 152 / 0.35);
    border-radius: 20px;
    background: rgb(253 250 247 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 18px 50px rgb(201 168 130 / 0.18);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--mf-muted);
  }

  @media (max-width: 989px) {
    .xalgo-museve-frames__media-wrap { gap: 1rem; }
    .xalgo-museve-frames__callout {
      position: static;
      max-width: min(100%, 560px);
      margin-top: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MUSEVE Frames",
  "tag": "section",
  "class": "section-wrapper xalgo-museve-frames-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Designed for every style" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real glasses first" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Four shapes, your colors, your prescription — in 24 g of pure titanium and acetate. The electronics hide in the temples."
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    { "type": "image_picker", "id": "frames_image", "label": "Frames image", "visible_if": "{{ section.settings.media_type == 'image' }}" },
    { "type": "video", "id": "frames_video", "label": "Frames video", "info": "Autoplays muted on loop.", "visible_if": "{{ section.settings.media_type == 'video' }}" },
    {
      "type": "textarea",
      "id": "callout_text",
      "label": "Glass callout",
      "default": "Photochromic lenses come standard — clear indoors, tinted outdoors."
    },
    { "type": "text", "id": "frame_colors_label", "label": "Frame colors group label", "default": "Frame colors" },
    { "type": "text", "id": "temple_finishes_label", "label": "Temple finishes group label", "default": "Temple finishes" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "show_shapes", "label": "Show shape chips in this point", "default": false },
        { "type": "checkbox", "id": "show_colors", "label": "Show color chips in this point", "default": false }
      ]
    },
    {
      "type": "shape",
      "name": "Frame shape",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Wellington" },
        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail" }
      ]
    },
    {
      "type": "colorway",
      "name": "Color",
      "settings": [
        {
          "type": "select",
          "id": "group",
          "label": "Group",
          "options": [
            { "value": "frame", "label": "Frame colors" },
            { "value": "temple", "label": "Temple finishes" }
          ],
          "default": "temple"
        },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "color", "id": "swatch", "label": "Swatch color", "default": "#1a1a1a" },
        { "type": "checkbox", "id": "to_be_announced", "label": "To be announced (dashed chip)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSEVE Frames",
      "category": "Content",
      "blocks": [
        { "type": "point", "settings": { "number": "01", "heading": "Your shape", "text": "Start with the one that already suits you.", "show_shapes": true } },
        { "type": "point", "settings": { "number": "02", "heading": "Your colors", "text": "Frame and temples are chosen separately.", "show_colors": true } },
        { "type": "point", "settings": { "number": "03", "heading": "Your lenses", "text": "Photochromic as standard. Prescription 1.56–1.74." } },
        { "type": "point", "settings": { "number": "04", "heading": "24 g, all day", "text": "Pure titanium temples and bridge, German-made OBE hinges. Light enough to forget." } },
        { "type": "shape", "settings": { "name": "Wellington" } },
        { "type": "shape", "settings": { "name": "Boston" } },
        { "type": "shape", "settings": { "name": "Panto" } },
        { "type": "shape", "settings": { "name": "Browline" } },
        { "type": "colorway", "settings": { "group": "frame", "name": "To be announced", "to_be_announced": true } },
        { "type": "colorway", "settings": { "group": "temple", "name": "Dark Brown", "swatch": "#3B241A" } },
        { "type": "colorway", "settings": { "group": "temple", "name": "Silver", "swatch": "#C0C0C0" } },
        { "type": "colorway", "settings": { "group": "temple", "name": "Gunmetal", "swatch": "#4A4F54" } },
        { "type": "colorway", "settings": { "group": "temple", "name": "Light Gold", "swatch": "#D6B56D" } },
        { "type": "colorway", "settings": { "group": "temple", "name": "Matte Black", "swatch": "#1A1A1A" } }
      ]
    }
  ]
}
{% endschema %}
