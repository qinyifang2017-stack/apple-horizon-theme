<section
  id="{{ section.settings.anchor_id }}"
  class="xalgo-xframe-memory-os color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="xalgo-xframe-memory-os__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-xframe-memory-os__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="xalgo-xframe-memory-os__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="xalgo-xframe-memory-os__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    <div class="xalgo-xframe-memory-os__console">
      <div class="xalgo-xframe-memory-os__rail" aria-hidden="true"></div>
      {%- for block in section.blocks -%}
        <article class="xalgo-xframe-memory-os__feature" {{ block.shopify_attributes }}>
          <div class="xalgo-xframe-memory-os__feature-top">
            <div class="xalgo-xframe-memory-os__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'cloud' -%}
                  <svg viewBox="0 0 24 24"><path d="M7 18h10.5a3.5 3.5 0 0 0 .6-6.95A5.5 5.5 0 0 0 7.5 9.5 4.25 4.25 0 0 0 7 18Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                {%- when 'spark' -%}
                  <svg viewBox="0 0 24 24"><path d="M12 3.5 13.8 9l5.7 1.8-5.7 1.8L12 18l-1.8-5.4-5.7-1.8L10.2 9 12 3.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m18.2 16.4.6 1.8 1.8.6-1.8.6-.6 1.8-.6-1.8-1.8-.6 1.8-.6.6-1.8Z" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
                {%- when 'people' -%}
                  <svg viewBox="0 0 24 24"><path d="M8.6 11.3a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM15.8 10.4a2.55 2.55 0 1 0 0-5.1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.8 19.2a5 5 0 0 1 9.6 0M13.8 17.7a4.2 4.2 0 0 1 6.4 1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                {%- when 'calendar' -%}
                  <svg viewBox="0 0 24 24"><path d="M5 6.5h14v13H5v-13ZM8 4v4M16 4v4M5 10h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M8 13h2M12 13h2M16 13h1M8 16h2M12 16h2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24"><path d="M5 5.5h14v13H5v-13Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m7.5 15.5 3.2-3.2 2 2 2.8-3.4 2 4.6M8.5 8.8h2.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </div>
            <span>{{ block.settings.kicker }}</span>
          </div>
          <h3>{{ block.settings.heading }}</h3>
          <div class="xalgo-xframe-memory-os__feature-text">{{ block.settings.text }}</div>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 720
              | image_tag:
                class: 'xalgo-xframe-memory-os__image',
                widths: '320, 520, 720',
                sizes: '(min-width: 990px) 26vw, 86vw',
                alt: block.settings.image.alt
            }}
          {%- else -%}
            <div class="xalgo-xframe-memory-os__mini-frame" aria-hidden="true"><span></span></div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .xalgo-xframe-memory-os {
    --xframe-paper: #fffaf2;
    --xframe-ink: var(--xalgo-text-primary, #1d1d1f);
    --xframe-muted: var(--xalgo-text-secondary, #6e6e73);
    --xframe-gold: var(--xalgo-champagne, #c9a882);
    --xframe-rose: var(--xalgo-rose, #e8a598);
    color: var(--xframe-ink);
    background:
      radial-gradient(circle at 12% 0%, rgb(232 165 152 / 0.18), transparent 28rem),
      linear-gradient(180deg, #fffaf6 0%, #f6eee4 100%);
    overflow: hidden;
  }

  .xalgo-xframe-memory-os .page-width {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-xframe-memory-os__header {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .xalgo-xframe-memory-os__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--xframe-rose);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .xalgo-xframe-memory-os__heading {
    margin: 0;
    color: var(--xframe-ink);
    font-size: clamp(2.6rem, 6vw, 6.2rem);
    line-height: 0.88;
    letter-spacing: -0.065em;
  }

  .xalgo-xframe-memory-os__body {
    max-width: 680px;
    margin: 1.25rem auto 0;
    color: var(--xframe-muted);
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.7;
  }

  .xalgo-xframe-memory-os__body p,
  .xalgo-xframe-memory-os__feature-text p {
    margin: 0;
  }

  .xalgo-xframe-memory-os__console {
    position: relative;
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  @media screen and (min-width: 990px) {
    .xalgo-xframe-memory-os__console {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .xalgo-xframe-memory-os__rail {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 4.4rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(201 168 130 / 0.42), rgb(232 165 152 / 0.42), transparent);
  }

  @media screen and (max-width: 989px) {
    .xalgo-xframe-memory-os__rail {
      display: none;
    }
  }

  .xalgo-xframe-memory-os__feature {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 430px;
    padding: clamp(1.25rem, 2.6vw, 1.8rem);
    border: 1px solid rgb(36 31 27 / 0.08);
    border-radius: clamp(28px, 4vw, 44px);
    background: rgb(255 250 242 / 0.78);
    box-shadow: 0 28px 86px rgb(91 63 37 / 0.11);
    backdrop-filter: blur(18px);
    overflow: hidden;
  }

  @media screen and (min-width: 990px) {
    .xalgo-xframe-memory-os__feature:nth-child(3) {
      margin-top: 3rem;
    }

    .xalgo-xframe-memory-os__feature:nth-child(4) {
      margin-top: 1.2rem;
    }
  }

  .xalgo-xframe-memory-os__feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.3rem;
  }

  .xalgo-xframe-memory-os__feature-top span {
    color: var(--xframe-rose);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .xalgo-xframe-memory-os__icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: color-mix(in srgb, var(--xframe-rose) 13%, white);
    color: var(--xframe-rose);
  }

  .xalgo-xframe-memory-os__icon svg {
    width: 28px;
    height: 28px;
  }

  .xalgo-xframe-memory-os__feature h3 {
    max-width: 9ch;
    margin: 0;
    color: var(--xframe-ink);
    font-size: clamp(2rem, 3.3vw, 3.5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .xalgo-xframe-memory-os__feature-text {
    margin-top: 1rem;
    color: var(--xframe-muted);
    line-height: 1.62;
  }

  .xalgo-xframe-memory-os__image,
  .xalgo-xframe-memory-os__mini-frame {
    width: 100%;
    aspect-ratio: 1.36;
    margin-top: auto;
    border-radius: 24px;
    object-fit: cover;
    overflow: hidden;
  }

  .xalgo-xframe-memory-os__mini-frame {
    position: relative;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #efe1ce, #dcebf0);
  }

  .xalgo-xframe-memory-os__mini-frame span {
    width: 72%;
    aspect-ratio: 1.45;
    border: 10px solid #2b211c;
    border-radius: 18px;
    background: linear-gradient(135deg, #fff6e8, #e8a598 54%, #b8d3dd);
    box-shadow: 0 18px 48px rgb(36 31 27 / 0.18);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "xFrame Memory OS",
  "tag": "section",
  "class": "section-wrapper xalgo-xframe-memory-os-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "xframe-memory-os"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Living Gallery OS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A frame that thinks in memories."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>xFrame combines AI album organization, cloud sync, and generative content so your photos become a living gallery instead of a forgotten camera roll.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Organize"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "album", "label": "Album" },
            { "value": "cloud", "label": "Cloud" },
            { "value": "spark", "label": "Spark" },
            { "value": "people", "label": "People" },
            { "value": "calendar", "label": "Calendar" }
          ],
          "default": "album"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "AI sorts the camera roll."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>People, places, scenes and important dates become living albums that are ready to display.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "xFrame Memory OS",
      "category": "Content",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
