<section
  id="{{ section.settings.anchor_id }}"
  class="xalgo-xframe-memory-os color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="xalgo-xframe-memory-os__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-xframe-memory-os__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="xalgo-xframe-memory-os__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="xalgo-xframe-memory-os__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    <div class="xalgo-xframe-memory-os__flow" aria-label="xFrame app generation flow">
      <article class="xalgo-xframe-memory-os__step xalgo-xframe-memory-os__step--chat">
        <div class="xalgo-xframe-memory-os__step-meta">
          <span>01</span>
          <strong>App chat</strong>
        </div>
        <div class="xalgo-xframe-memory-os__phone">
          <div class="xalgo-xframe-memory-os__phone-bar" aria-hidden="true"></div>
          <div class="xalgo-xframe-memory-os__message xalgo-xframe-memory-os__message--user">
            <span>You</span>
            <p>{{ section.settings.prompt_text }}</p>
          </div>
          <div class="xalgo-xframe-memory-os__message xalgo-xframe-memory-os__message--ai">
            <span>AI</span>
            <p>{{ section.settings.ai_status_text }}</p>
          </div>
        </div>
      </article>

      <div class="xalgo-xframe-memory-os__connector" aria-hidden="true">
        <span></span>
      </div>

      <article class="xalgo-xframe-memory-os__step xalgo-xframe-memory-os__step--result">
        <div class="xalgo-xframe-memory-os__step-meta">
          <span>02</span>
          <strong>AI result</strong>
        </div>
        <div class="xalgo-xframe-memory-os__result-card">
          <div class="xalgo-xframe-memory-os__generated-art" aria-hidden="true">
            {%- if section.settings.result_image != blank -%}
              {{
                section.settings.result_image
                | image_url: width: 900
                | image_tag:
                  class: 'xalgo-xframe-memory-os__art-image',
                  widths: '360, 560, 720, 900',
                  sizes: '(min-width: 990px) 26vw, 86vw',
                  alt: section.settings.result_image.alt
              }}
            {%- endif -%}
          </div>
          <div class="xalgo-xframe-memory-os__result-copy">
            <h3>{{ section.settings.result_heading }}</h3>
            <p>{{ section.settings.result_text }}</p>
          </div>
        </div>
      </article>

      <div class="xalgo-xframe-memory-os__connector" aria-hidden="true">
        <span></span>
      </div>

      <article class="xalgo-xframe-memory-os__step xalgo-xframe-memory-os__step--frame">
        <div class="xalgo-xframe-memory-os__step-meta">
          <span>03</span>
          <strong>xFrame display</strong>
        </div>
        <div class="xalgo-xframe-memory-os__frame-card">
          <div class="xalgo-xframe-memory-os__mini-frame" aria-hidden="true">
            <span>
              {%- if section.settings.frame_image != blank -%}
                {{
                  section.settings.frame_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'xalgo-xframe-memory-os__art-image',
                    widths: '360, 560, 720, 900',
                    sizes: '(min-width: 990px) 26vw, 86vw',
                    alt: section.settings.frame_image.alt
                }}
              {%- endif -%}
            </span>
          </div>
          <label class="xalgo-xframe-memory-os__check">
            <input type="checkbox" checked disabled>
            <span>{{ section.settings.approval_text }}</span>
          </label>
          <p>{{ section.settings.sync_text }}</p>
        </div>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .xalgo-xframe-memory-os {
    --xframe-paper: #fffaf2;
    --xframe-sand: #f5eadb;
    --xframe-clay: #d7b894;
    --xframe-ink: var(--xalgo-text-primary, #1d1d1f);
    --xframe-muted: var(--xalgo-text-secondary, #6e6e73);
    --xframe-gold: var(--xalgo-champagne, #c9a882);
    --xframe-rose: var(--xalgo-rose, #e8a598);
    position: relative;
    color: var(--xframe-ink);
    background: linear-gradient(180deg, #fbf8f3 0%, #f6efe6 100%);
    overflow: hidden;
  }

  .xalgo-xframe-memory-os::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 18%, rgb(255 250 242 / 0.72), transparent 24rem),
      linear-gradient(90deg, rgb(93 68 45 / 0.018) 1px, transparent 1px),
      linear-gradient(0deg, rgb(93 68 45 / 0.014) 1px, transparent 1px);
    background-size: auto, 72px 72px, 72px 72px;
    mask-image: linear-gradient(180deg, transparent, black 18%, black 82%, transparent);
    pointer-events: none;
  }

  .xalgo-xframe-memory-os .page-width {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-xframe-memory-os__header {
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
  }

  .xalgo-xframe-memory-os__eyebrow {
    margin: 0 0 0.9rem;
    color: var(--xframe-muted);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
  }

  .xalgo-xframe-memory-os__heading {
    max-width: none;
    margin: 0 auto;
    color: var(--xframe-ink);
    font-size: var(--font-h2--size);
    line-height: var(--font-h2--line-height);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .xalgo-xframe-memory-os__heading {
      max-width: 11ch;
      font-size: clamp(2rem, 8.5vw, 2.75rem);
      white-space: normal;
    }
  }

  .xalgo-xframe-memory-os__body {
    max-width: 620px;
    margin: 1.1rem auto 0;
    color: var(--xframe-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .xalgo-xframe-memory-os__body p,
  .xalgo-xframe-memory-os__message p,
  .xalgo-xframe-memory-os__result-copy p,
  .xalgo-xframe-memory-os__frame-card p {
    margin: 0;
  }

  .xalgo-xframe-memory-os__flow {
    display: grid;
    gap: clamp(1rem, 2vw, 1.4rem);
    margin-top: clamp(3rem, 5vw, 4.5rem);
  }

  @media screen and (min-width: 990px) {
    .xalgo-xframe-memory-os__flow {
      grid-template-columns: minmax(0, 1.05fr) 56px minmax(0, 1fr) 56px minmax(0, 1.05fr);
      align-items: center;
    }
  }

  .xalgo-xframe-memory-os__step {
    position: relative;
    min-height: 430px;
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid rgb(93 68 45 / 0.08);
    border-radius: clamp(28px, 4vw, 42px);
    background:
      linear-gradient(180deg, rgb(255 252 247 / 0.9), rgb(250 242 232 / 0.76)),
      rgb(255 250 242 / 0.8);
    box-shadow: 0 22px 58px rgb(93 68 45 / 0.09);
    backdrop-filter: blur(18px);
    overflow: hidden;
  }

  .xalgo-xframe-memory-os__step::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.72;
    pointer-events: none;
  }

  .xalgo-xframe-memory-os__step > * {
    position: relative;
    z-index: 1;
  }

  .xalgo-xframe-memory-os__step--chat::before {
    background:
      radial-gradient(circle at 18% 14%, rgb(196 143 96 / 0.16), transparent 15rem),
      linear-gradient(160deg, transparent 0 58%, rgb(93 68 45 / 0.035) 58% 100%);
  }

  .xalgo-xframe-memory-os__step--result::before {
    background:
      radial-gradient(circle at 78% 16%, rgb(215 184 148 / 0.22), transparent 15rem),
      repeating-linear-gradient(135deg, rgb(93 68 45 / 0.032) 0 1px, transparent 1px 13px);
  }

  .xalgo-xframe-memory-os__step--frame::before {
    background:
      radial-gradient(circle at 50% 14%, rgb(151 126 99 / 0.13), transparent 16rem),
      linear-gradient(180deg, transparent 0 62%, rgb(215 184 148 / 0.12) 100%);
  }

  @media screen and (min-width: 990px) {
    .xalgo-xframe-memory-os__step--result {
      transform: translateY(2rem);
    }
  }

  .xalgo-xframe-memory-os__step-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .xalgo-xframe-memory-os__step-meta span {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    background: rgb(154 108 74 / 0.1);
    color: #9a6c4a;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .xalgo-xframe-memory-os__step-meta strong {
    color: #9a6c4a;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .xalgo-xframe-memory-os__phone,
  .xalgo-xframe-memory-os__result-card,
  .xalgo-xframe-memory-os__frame-card {
    flex: 1;
  }

  .xalgo-xframe-memory-os__phone {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 0.85rem;
    border-radius: 28px;
    background: linear-gradient(180deg, #2a221d, #3a2b22);
    box-shadow: inset 0 0 0 1px rgb(255 250 242 / 0.12);
  }

  .xalgo-xframe-memory-os__phone-bar {
    width: 34%;
    height: 0.38rem;
    margin: 0 auto 0.4rem;
    border-radius: 999px;
    background: rgb(255 250 242 / 0.26);
  }

  .xalgo-xframe-memory-os__message {
    max-width: 92%;
    padding: 0.78rem 0.9rem;
    border-radius: 20px;
    font-size: 0.88rem;
    line-height: 1.48;
  }

  .xalgo-xframe-memory-os__message span {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .xalgo-xframe-memory-os__message--user {
    align-self: flex-end;
    background: #d9b28c;
    color: #2d211b;
  }

  .xalgo-xframe-memory-os__message--ai {
    align-self: flex-start;
    background: rgb(255 250 242 / 0.12);
    color: rgb(255 250 242 / 0.82);
  }

  .xalgo-xframe-memory-os__connector {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .xalgo-xframe-memory-os__connector {
      display: grid;
      place-items: center;
    }
  }

  .xalgo-xframe-memory-os__connector span {
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, rgb(154 108 74 / 0.12), rgb(154 108 74 / 0.55), rgb(154 108 74 / 0.12));
  }

  .xalgo-xframe-memory-os__connector span::after {
    content: '';
    display: block;
    width: 10px;
    height: 10px;
    margin: -4px 0 0 auto;
    border-top: 2px solid rgb(154 108 74 / 0.7);
    border-right: 2px solid rgb(154 108 74 / 0.7);
    transform: rotate(45deg);
  }

  .xalgo-xframe-memory-os__result-card {
    display: grid;
    grid-template-rows: minmax(210px, 1fr) auto;
    gap: 1rem;
  }

  .xalgo-xframe-memory-os__generated-art,
  .xalgo-xframe-memory-os__mini-frame span {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 20%, #ffe1a9 0 10%, transparent 26%),
      radial-gradient(circle at 82% 18%, #8eb9c9 0 14%, transparent 34%),
      linear-gradient(180deg, #f6c9a5 0%, #eca77e 44%, #78b0c1 45%, #b9d8dd 100%);
  }

  .xalgo-xframe-memory-os__generated-art::before,
  .xalgo-xframe-memory-os__mini-frame span::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.1), transparent 24%, rgb(36 31 27 / 0.08) 49%, transparent 52%),
      radial-gradient(ellipse at 28% 82%, rgb(255 250 242 / 0.24), transparent 34%);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .xalgo-xframe-memory-os__art-image {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xalgo-xframe-memory-os__generated-art {
    min-height: 200px;
    border-radius: 26px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.42);
  }

  .xalgo-xframe-memory-os__result-copy h3 {
    margin: 0 0 0.35rem;
    color: var(--xframe-ink);
    font-size: clamp(1.15rem, 1.7vw, 1.48rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .xalgo-xframe-memory-os__result-copy p,
  .xalgo-xframe-memory-os__frame-card p {
    color: var(--xframe-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .xalgo-xframe-memory-os__frame-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .xalgo-xframe-memory-os__mini-frame {
    display: grid;
    place-items: center;
    min-height: 220px;
    border-radius: 28px;
    background:
      radial-gradient(circle at 50% 44%, rgb(255 252 247 / 0.72), transparent 11rem),
      linear-gradient(145deg, #efe1ce, #e7d4bd);
  }

  .xalgo-xframe-memory-os__mini-frame span {
    width: 80%;
    aspect-ratio: 1.45;
    border: 8px solid #2b211c;
    border-radius: 16px;
    box-shadow: 0 16px 40px rgb(36 31 27 / 0.16);
  }

  .xalgo-xframe-memory-os__check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.72rem 0.85rem;
    border: 1px solid rgb(154 108 74 / 0.16);
    border-radius: 999px;
    background: rgb(255 252 247 / 0.62);
    color: var(--xframe-ink);
    font-size: 0.92rem;
    font-weight: 800;
  }

  .xalgo-xframe-memory-os__check input {
    width: 1rem;
    height: 1rem;
    accent-color: #9a6c4a;
  }

  @media screen and (max-width: 749px) {
    .xalgo-xframe-memory-os__step {
      min-height: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "xFrame Memory OS",
  "tag": "section",
  "class": "section-wrapper xalgo-xframe-memory-os-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "xframe-memory-os"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "App to frame flow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create it in the app. Approve it for the frame."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Use app chat to describe the image, review the AI result, then decide whether it should sync to xFrame.</p>"
    },
    {
      "type": "text",
      "id": "prompt_text",
      "label": "Prompt text",
      "default": "Create a sunrise beach image in a Van Gogh-inspired style."
    },
    {
      "type": "text",
      "id": "ai_status_text",
      "label": "AI status text",
      "default": "Generating a painterly sunrise beach scene for review."
    },
    {
      "type": "text",
      "id": "result_heading",
      "label": "Result heading",
      "default": "Sunrise Beach"
    },
    {
      "type": "text",
      "id": "result_text",
      "label": "Result text",
      "default": "A warm, brush-like seaside image returns to the app conversation first."
    },
    {
      "type": "image_picker",
      "id": "result_image",
      "label": "AI result image"
    },
    {
      "type": "image_picker",
      "id": "frame_image",
      "label": "Frame display image"
    },
    {
      "type": "text",
      "id": "approval_text",
      "label": "Approval text",
      "default": "Show on xFrame"
    },
    {
      "type": "text",
      "id": "sync_text",
      "label": "Sync text",
      "default": "Once approved, cloud sync sends the selected image to the paired frame."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "xFrame Memory OS",
      "category": "Content"
    }
  ]
}
{% endschema %}
