<section
  class="xalgo-xframe-hero color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width xalgo-xframe-hero__shell">
    <div class="xalgo-xframe-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-xframe-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="xalgo-xframe-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="xalgo-xframe-hero__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="xalgo-xframe-hero__actions">
        {%- if section.settings.primary_button_label != blank -%}
          <a class="button" href="{{ section.settings.primary_button_link }}">{{ section.settings.primary_button_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a class="button-secondary" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="xalgo-xframe-hero__gallery" aria-label="xFrame smart gallery preview">
      <div class="xalgo-xframe-hero__art-card xalgo-xframe-hero__art-card--one" aria-hidden="true"></div>
      <div class="xalgo-xframe-hero__art-card xalgo-xframe-hero__art-card--two" aria-hidden="true"></div>

      <div class="xalgo-xframe-hero__frame">
        <div class="xalgo-xframe-hero__screen">
          {%- if section.settings.hero_image != blank -%}
            {{
              section.settings.hero_image
              | image_url: width: 1400
              | image_tag:
                class: 'xalgo-xframe-hero__image',
                widths: '520, 760, 1000, 1400',
                sizes: '(min-width: 990px) 42vw, 88vw',
                alt: section.settings.hero_image.alt
            }}
          {%- else -%}
            <div class="xalgo-xframe-hero__placeholder" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="xalgo-xframe-hero__chips" aria-label="xFrame capabilities">
        {%- if section.settings.accent_label_1 != blank -%}
          <span>{{ section.settings.accent_label_1 }}</span>
        {%- endif -%}
        {%- if section.settings.accent_label_2 != blank -%}
          <span>{{ section.settings.accent_label_2 }}</span>
        {%- endif -%}
        {%- if section.settings.accent_label_3 != blank -%}
          <span>{{ section.settings.accent_label_3 }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xalgo-xframe-hero {
    --xframe-wall: #241f1b;
    --xframe-paper: #fffaf2;
    --xframe-ink: var(--xalgo-text-primary, #1d1d1f);
    --xframe-muted: var(--xalgo-text-secondary, #6e6e73);
    --xframe-gold: var(--xalgo-champagne, #c9a882);
    --xframe-rose: var(--xalgo-rose, #e8a598);
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    color: var(--xframe-paper);
    background:
      radial-gradient(circle at 78% 18%, rgb(232 165 152 / 0.22), transparent 28rem),
      radial-gradient(circle at 16% 86%, rgb(201 168 130 / 0.18), transparent 24rem),
      linear-gradient(135deg, #342a25 0%, var(--xframe-wall) 52%, #151211 100%);
  }

  .xalgo-xframe-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(255 250 242 / 0.035) 1px, transparent 1px),
      linear-gradient(0deg, rgb(255 250 242 / 0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle at 72% 46%, #000 0, transparent 68%);
  }

  .xalgo-xframe-hero .page-width {
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-xframe-hero__shell {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .xalgo-xframe-hero__shell {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    }
  }

  .xalgo-xframe-hero__eyebrow {
    margin: 0 0 1rem;
    color: color-mix(in srgb, var(--xframe-rose) 86%, white);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .xalgo-xframe-hero__heading {
    max-width: 10ch;
    margin: 0;
    color: var(--xframe-paper);
    font-size: clamp(3.8rem, 9vw, 8.8rem);
    line-height: 0.82;
    letter-spacing: -0.08em;
  }

  .xalgo-xframe-hero__subheading {
    max-width: 640px;
    margin-top: 1.5rem;
    color: rgb(255 250 242 / 0.76);
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    line-height: 1.62;
  }

  .xalgo-xframe-hero__subheading p {
    margin: 0;
  }

  .xalgo-xframe-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .xalgo-xframe-hero__gallery {
    position: relative;
    min-height: clamp(430px, 54vw, 720px);
    display: grid;
    place-items: center;
    perspective: 1200px;
  }

  .xalgo-xframe-hero__frame {
    position: relative;
    width: min(100%, 680px);
    aspect-ratio: 1.38;
    padding: clamp(0.8rem, 1.8vw, 1.25rem);
    border-radius: clamp(24px, 4vw, 44px);
    background:
      linear-gradient(145deg, #fff6e8, #a98055 42%, #31251d 43%, #120f0d 100%);
    box-shadow:
      0 44px 120px rgb(0 0 0 / 0.42),
      inset 0 1px 0 rgb(255 255 255 / 0.36);
    transform: rotateY(-8deg) rotateX(2deg);
  }

  .xalgo-xframe-hero__screen {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: clamp(16px, 3vw, 30px);
    background: #17110f;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .xalgo-xframe-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xalgo-xframe-hero__placeholder {
    height: 100%;
    display: grid;
    grid-template-columns: 1.16fr 0.84fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    padding: 0.75rem;
    background: linear-gradient(135deg, #f4dfcc 0%, #dbeaf2 48%, #f7f1e8 100%);
  }

  .xalgo-xframe-hero__placeholder span {
    border-radius: 18px;
    background: linear-gradient(135deg, rgb(36 31 27 / 0.12), rgb(255 255 255 / 0.62));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.28);
  }

  .xalgo-xframe-hero__placeholder span:first-child {
    grid-row: 1 / -1;
    background: radial-gradient(circle at 38% 24%, #e8a598, transparent 24%), linear-gradient(145deg, #fff7ea, #c9a882);
  }

  .xalgo-xframe-hero__art-card {
    position: absolute;
    width: clamp(150px, 18vw, 260px);
    aspect-ratio: 0.78;
    border: 10px solid rgb(255 250 242 / 0.92);
    border-radius: 18px;
    box-shadow: 0 28px 74px rgb(0 0 0 / 0.28);
  }

  .xalgo-xframe-hero__art-card--one {
    left: 0;
    top: 8%;
    background: linear-gradient(145deg, #e7b9a9, #f7efe1 58%, #99b6c2);
    transform: rotate(-9deg);
  }

  .xalgo-xframe-hero__art-card--two {
    right: 2%;
    bottom: 2%;
    background: radial-gradient(circle at 38% 32%, #fcdcdd, transparent 34%), linear-gradient(145deg, #fbf4ea, #c9a882);
    transform: rotate(8deg);
  }

  .xalgo-xframe-hero__chips {
    position: absolute;
    inset: auto auto 7% 4%;
    display: grid;
    gap: 0.65rem;
  }

  .xalgo-xframe-hero__chips span {
    width: fit-content;
    padding: 0.72rem 0.9rem;
    border: 1px solid rgb(255 250 242 / 0.18);
    border-radius: 999px;
    background: rgb(255 250 242 / 0.13);
    color: var(--xframe-paper);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.18);
    backdrop-filter: blur(18px);
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .xalgo-xframe-hero {
      min-height: auto;
    }

    .xalgo-xframe-hero__heading {
      max-width: 9ch;
    }

    .xalgo-xframe-hero__frame {
      transform: none;
    }

    .xalgo-xframe-hero__art-card {
      opacity: 0.62;
    }

    .xalgo-xframe-hero__chips {
      position: static;
      margin-top: 1rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "xFrame Hero",
  "tag": "section",
  "class": "section-wrapper xalgo-xframe-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "xFrame 智能画框"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your memories, curated by AI."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>xFrame organizes your albums, generates beautiful new visuals, and keeps every frame in sync through the cloud.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Choose xFrame"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "See AI features"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Frame screen image"
    },
    {
      "type": "text",
      "id": "accent_label_1",
      "label": "Accent label 1",
      "default": "AI album curation"
    },
    {
      "type": "text",
      "id": "accent_label_2",
      "label": "Accent label 2",
      "default": "Cloud synced"
    },
    {
      "type": "text",
      "id": "accent_label_3",
      "label": "Accent label 3",
      "default": "Generate new scenes"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "xFrame Hero",
      "category": "Content"
    }
  ]
}
{% endschema %}
