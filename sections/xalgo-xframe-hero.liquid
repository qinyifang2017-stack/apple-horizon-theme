<section
  class="xalgo-xframe-hero color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width xalgo-xframe-hero__shell">
    <div class="xalgo-xframe-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-xframe-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="xalgo-xframe-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="xalgo-xframe-hero__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="xalgo-xframe-hero__actions">
        {%- if section.settings.primary_button_label != blank -%}
          <a class="button" href="{{ section.settings.primary_button_link }}">{{ section.settings.primary_button_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a class="button-secondary" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="xalgo-xframe-hero__gallery" aria-label="xFrame smart gallery preview">
      <div class="xalgo-xframe-hero__frame">
        <div class="xalgo-xframe-hero__frame-bar" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="xalgo-xframe-hero__screen">
          {%- if section.settings.hero_image != blank -%}
            {{
              section.settings.hero_image
              | image_url: width: 1400
              | image_tag:
                class: 'xalgo-xframe-hero__image',
                widths: '520, 760, 1000, 1400',
                sizes: '(min-width: 990px) 42vw, 88vw',
                alt: section.settings.hero_image.alt
            }}
          {%- else -%}
            <div class="xalgo-xframe-hero__placeholder" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="xalgo-xframe-hero__chips" aria-label="xFrame capabilities">
        {%- if section.settings.accent_label_1 != blank -%}
          <span>{{ section.settings.accent_label_1 }}</span>
        {%- endif -%}
        {%- if section.settings.accent_label_2 != blank -%}
          <span>{{ section.settings.accent_label_2 }}</span>
        {%- endif -%}
        {%- if section.settings.accent_label_3 != blank -%}
          <span>{{ section.settings.accent_label_3 }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xalgo-xframe-hero {
    --xframe-wall: #241f1b;
    --xframe-paper: #fffaf2;
    --xframe-ink: var(--xalgo-text-primary, #1d1d1f);
    --xframe-muted: var(--xalgo-text-secondary, #6e6e73);
    --xframe-gold: var(--xalgo-champagne, #c9a882);
    --xframe-rose: var(--xalgo-rose, #e8a598);
    position: relative;
    min-height: auto;
    display: grid;
    align-items: center;
    overflow: hidden;
    color: var(--xframe-paper);
    background:
      radial-gradient(circle at 78% 18%, rgb(232 165 152 / 0.22), transparent 28rem),
      radial-gradient(circle at 16% 86%, rgb(201 168 130 / 0.18), transparent 24rem),
      linear-gradient(135deg, #342a25 0%, var(--xframe-wall) 52%, #151211 100%);
  }

  .xalgo-xframe-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(255 250 242 / 0.035) 1px, transparent 1px),
      linear-gradient(0deg, rgb(255 250 242 / 0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle at 72% 46%, #000 0, transparent 68%);
  }

  .xalgo-xframe-hero .page-width {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-xframe-hero__shell {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .xalgo-xframe-hero__shell {
      grid-template-columns: minmax(0, 0.76fr) minmax(0, 1.24fr);
    }
  }

  .xalgo-xframe-hero__eyebrow {
    margin: 0 0 1rem;
    color: color-mix(in srgb, var(--xframe-rose) 86%, white);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .xalgo-xframe-hero__heading {
    max-width: 10ch;
    margin: 0;
    color: var(--xframe-paper);
    font-size: clamp(2.5rem, 5.2vw, 5rem);
    line-height: 0.86;
    letter-spacing: -0.08em;
  }

  .xalgo-xframe-hero__subheading {
    max-width: 640px;
    margin-top: 1.2rem;
    color: rgb(255 250 242 / 0.76);
    font-size: 1.25rem;
    line-height: 1.62;
  }

  @media screen and (max-width: 749px) {
    .xalgo-xframe-hero__subheading {
      font-size: 1.1rem;
    }
  }

  .xalgo-xframe-hero__subheading p {
    margin: 0;
  }

  .xalgo-xframe-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.55rem;
  }

  .xalgo-xframe-hero__actions .button:not(.button-secondary) {
    --button-color: #ffffff;
    --button-background-color: #E8A598;
    --button-border-color: #E8A598;
    color: #ffffff !important;
    background-color: #E8A598 !important;
    border-color: #E8A598 !important;
  }

  .xalgo-xframe-hero__actions .button:not(.button-secondary):hover {
    --button-color: #ffffff;
    --button-background-color: #D4918A;
    --button-border-color: #D4918A;
    color: #ffffff !important;
    background-color: #D4918A !important;
    border-color: #D4918A !important;
  }

  .xalgo-xframe-hero__actions .button-secondary {
    border-color: rgb(255 250 242 / 0.5);
    background: transparent;
    color: var(--xframe-paper);
    box-shadow: none;
  }

  .xalgo-xframe-hero__actions .button-secondary:hover {
    border-color: rgb(255 250 242 / 0.5) !important;
    background: var(--xframe-paper) !important;
    background-color: var(--xframe-paper) !important;
    box-shadow: none;
  }

  .xalgo-xframe-hero__gallery {
    position: relative;
    min-height: clamp(420px, 40vw, 560px);
    display: grid;
    place-items: center;
    perspective: 1200px;
  }

  .xalgo-xframe-hero__frame {
    position: relative;
    width: min(100%, 740px);
    aspect-ratio: 1.36;
    padding: clamp(0.7rem, 1.4vw, 1rem);
    border-radius: clamp(24px, 4vw, 42px);
    background:
      linear-gradient(145deg, rgb(241 237 229 / 0.48) 0%, rgb(201 192 180 / 0.4) 44%, rgb(139 130 120 / 0.38) 100%);
    box-shadow:
      0 44px 120px rgb(0 0 0 / 0.42),
      inset 0 1px 0 rgb(255 255 255 / 0.55);
  }

  .xalgo-xframe-hero__frame-bar {
    position: absolute;
    top: clamp(0.55rem, 1.2vw, 0.8rem);
    left: 50%;
    z-index: 2;
    display: flex;
    gap: 0.35rem;
    transform: translateX(-50%);
  }

  .xalgo-xframe-hero__frame-bar span {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: rgb(255 250 242 / 0.36);
  }

  .xalgo-xframe-hero__screen {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: clamp(18px, 3vw, 32px);
    background: #11100e;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .xalgo-xframe-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xalgo-xframe-hero__placeholder {
    height: 100%;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 14% 18%, rgb(255 210 177 / 0.95) 0 6%, transparent 15%),
      radial-gradient(circle at 82% 18%, rgb(168 211 226 / 0.82) 0 11%, transparent 30%),
      linear-gradient(180deg, #f7e1c6 0%, #efc198 45%, #7fb3c5 46%, #b9d5dc 100%);
  }

  .xalgo-xframe-hero__placeholder::before,
  .xalgo-xframe-hero__placeholder::after {
    content: '';
    position: absolute;
    inset-inline: -8%;
    bottom: 17%;
    height: 24%;
    border-radius: 50% 50% 0 0;
    background: rgb(255 250 242 / 0.22);
    transform: rotate(-2deg);
  }

  .xalgo-xframe-hero__placeholder::after {
    bottom: 8%;
    height: 18%;
    background: rgb(36 31 27 / 0.12);
    transform: rotate(2deg);
  }

  .xalgo-xframe-hero__chips {
    position: absolute;
    inset: auto auto 7% 4%;
    display: grid;
    gap: 0.65rem;
  }

  .xalgo-xframe-hero__chips span {
    width: fit-content;
    padding: 0.72rem 0.9rem;
    border: 1px solid rgb(255 250 242 / 0.18);
    border-radius: 999px;
    background: rgb(255 250 242 / 0.13);
    color: var(--xframe-paper);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.18);
    backdrop-filter: blur(18px);
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .xalgo-xframe-hero {
      min-height: auto;
    }

    .xalgo-xframe-hero__heading {
      max-width: 9ch;
    }

    .xalgo-xframe-hero__frame {
      transform: none;
      width: min(100%, 620px);
    }

    .xalgo-xframe-hero__chips {
      position: static;
      margin-top: 1rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "xFrame Hero",
  "tag": "section",
  "class": "section-wrapper xalgo-xframe-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "xFrame Smart Frame"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your memories, curated by AI."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>xFrame organizes your albums, generates beautiful new visuals, and keeps every frame in sync through the cloud.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Choose your xFrame"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Read FAQ"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Frame screen image"
    },
    {
      "type": "text",
      "id": "accent_label_1",
      "label": "Accent label 1",
      "default": "AI album curation"
    },
    {
      "type": "text",
      "id": "accent_label_2",
      "label": "Accent label 2",
      "default": "Cloud synced"
    },
    {
      "type": "text",
      "id": "accent_label_3",
      "label": "Accent label 3",
      "default": "Generate new scenes"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "xFrame Hero",
      "category": "Content"
    }
  ]
}
{% endschema %}
