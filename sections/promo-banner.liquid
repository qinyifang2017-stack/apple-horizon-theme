{% liquid
  assign media_type = section.settings.media_type
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign has_media = false
  assign use_asset_fallback = false

  if media_type == 'image' and desktop_image != blank
    assign has_media = true
  elsif media_type == 'video' and section.settings.video != blank
    assign has_media = true
  elsif media_type == 'image' and section.settings.use_default_asset_images
    assign has_media = true
    assign use_asset_fallback = true
  endif
%}

{%- if section.settings.enabled -%}
  <div
    id="PromoBanner-{{ section.id }}"
    class="promo-banner color-{{ section.settings.color_scheme }} promo-banner--layout-{{ section.settings.layout_style | default: 'full' }} promo-banner--overlay-{{ section.settings.overlay_position }}{% if has_media %} promo-banner--has-media{% else %} promo-banner--no-media{% endif %}"
    style="
      {% if section.settings.section_height == 'custom' %}
        --promo-min-height: {{ section.settings.section_height_custom }}svh;
      {% elsif section.settings.section_height == 'full-screen' %}
        --promo-min-height: 100svh;
      {% else %}
        --promo-min-height: var(--section-height-{{ section.settings.section_height }}, 80svh);
      {% endif %}
      --promo-overlay-background: {{ section.settings.overlay_card_background }};
      --promo-backdrop-opacity: {{ section.settings.backdrop_opacity | divided_by: 100.0 }};
    "
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <div class="promo-banner__background" aria-hidden="true">
      {%- if has_media -%}
        {%- if media_type == 'image' -%}
          {%- if use_asset_fallback -%}
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="{{ 'xglass-campaign-hero-mobile.jpg' | asset_url }}"
              >
              <img
                src="{{ 'xglass-campaign-hero-desktop.jpg' | asset_url }}"
                alt="{{ section.settings.background_alt | escape }}"
                class="promo-banner__background-media"
                fetchpriority="high"
              >
            </picture>
          {%- else -%}
            <picture>
              {%- if section.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ mobile_image | image_url: width: 1200 }}"
                >
              {%- endif -%}
              {{
                desktop_image
                | image_url: width: 3840
                | image_tag:
                  class: 'promo-banner__background-media',
                  widths: '832, 1200, 1600, 1920, 2560, 3840',
                  sizes: '100vw',
                  fetchpriority: 'high',
                  alt: section.settings.background_alt
                | default: desktop_image.alt
              }}
            </picture>
          {%- endif -%}
        {%- else -%}
          {{
            section.settings.video
            | video_tag:
              autoplay: true,
              loop: true,
              controls: false,
              muted: true,
              class: 'promo-banner__background-media'
          }}
        {%- endif -%}
      {%- else -%}
        <div class="promo-banner__upload-prompt">
          <span>Upload a full-screen xGlass campaign image</span>
        </div>
      {%- endif -%}
      <div class="promo-banner__backdrop"></div>
    </div>

    {%- if section.settings.link != blank -%}
      <a
        href="{{ section.settings.link }}"
        class="promo-banner__link"
        {% if section.settings.open_in_new_tab %}
          target="_blank" rel="noopener"
        {% endif %}
        aria-label="{{ section.settings.link_accessibility_text | default: 'Promotion' | escape }}"
      ></a>
    {%- endif -%}

    <div
      class="promo-banner__container section section--full-width spacing-style"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="promo-banner__overlay-card {{ section.settings.section_width }}">
        <div
          class="
            promo-banner__content
            layout-panel-flex
            layout-panel-flex--{{ section.settings.content_direction }}
            {% if section.settings.vertical_on_mobile %}mobile-column{% endif %}
            section-content-wrapper
          "
          style="{% render 'layout-panel-style', settings: section.settings %}"
        >
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .promo-banner {
    position: relative;
    display: flex;
    min-height: var(--promo-min-height);
    overflow: hidden;
    background: #f5f5f7;
    color: var(--color-foreground);
    isolation: isolate;
  }

  .promo-banner__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .promo-banner__background picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .promo-banner__background-media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .promo-banner__backdrop {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 42%) 0%, rgb(0 0 0 / 14%) 30%, rgb(0 0 0 / 0%) 55%),
      linear-gradient(0deg, rgb(0 0 0 / 44%) 0%, rgb(0 0 0 / 12%) 26%, rgb(0 0 0 / 0%) 52%);
    pointer-events: none;
  }

  .promo-banner--overlay-center .promo-banner__backdrop {
    background: rgb(0 0 0 / var(--promo-backdrop-opacity));
  }

  .promo-banner--overlay-right .promo-banner__backdrop {
    background:
      linear-gradient(
        270deg,
        rgb(0 0 0 / calc(var(--promo-backdrop-opacity) + 0.12)) 0%,
        rgb(0 0 0 / var(--promo-backdrop-opacity)) 36%,
        rgb(0 0 0 / 0%) 70%
      ),
      linear-gradient(0deg, rgb(0 0 0 / 18%) 0%, rgb(0 0 0 / 0%) 45%);
  }

  .promo-banner--no-media .promo-banner__background {
    background:
      radial-gradient(circle at 70% 35%, rgb(5 150 105 / 18%) 0 18%, transparent 42%),
      linear-gradient(135deg, #f7fff9 0%, #edf8ef 48%, #ffffff 100%);
  }

  .promo-banner--no-media .promo-banner__backdrop {
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 86%) 0%,
      rgb(255 255 255 / 32%) 58%,
      rgb(255 255 255 / 0%) 100%
    );
  }

  .promo-banner__upload-prompt {
    position: absolute;
    right: clamp(24px, 8vw, 120px);
    bottom: clamp(32px, 10vw, 120px);
    display: grid;
    width: min(42vw, 560px);
    min-height: min(38vw, 420px);
    place-items: center;
    border: 1px dashed rgb(5 150 105 / 30%);
    border-radius: 44px;
    background: rgb(255 255 255 / 48%);
    color: rgb(29 29 31 / 48%);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .promo-banner__link {
    position: absolute;
    z-index: 2;
    inset: 0;
  }

  .promo-banner__container {
    position: relative;
    z-index: 3;
    display: flex;
    width: 100%;
    min-height: var(--promo-min-height);
  }

  .promo-banner__overlay-card {
    display: flex;
    width: 100%;
    margin-inline: auto;
    padding-inline: clamp(24px, 5vw, 88px);
    align-items: stretch;
    box-sizing: border-box;
  }

  .promo-banner--overlay-left .promo-banner__overlay-card {
    justify-content: center;
  }

  .promo-banner--overlay-center .promo-banner__overlay-card {
    justify-content: center;
    text-align: center;
  }

  .promo-banner--overlay-right .promo-banner__overlay-card {
    justify-content: flex-end;
  }

  .promo-banner__content {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    padding: 0 clamp(20px, 4vw, 64px);
    align-items: center;
    text-align: center;
    text-shadow: 0 1px 22px rgb(0 0 0 / 22%);
    transform: none;
    pointer-events: none;
    box-sizing: border-box;
  }

  .promo-banner__content > * {
    pointer-events: auto;
  }

  .promo-banner__content h1,
  .promo-banner__content h2 {
    max-width: none;
    margin-block: 0;
    font-size: clamp(3.4rem, 7vw, 7.5rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .promo-banner__content p {
    max-width: 26rem;
    margin-inline: auto;
    font-size: clamp(1rem, 1.35vw, 1.3rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .promo-banner--has-media .promo-banner__content,
  .promo-banner--has-media .promo-banner__content h1,
  .promo-banner--has-media .promo-banner__content h2,
  .promo-banner--has-media .promo-banner__content p {
    color: #fff;
  }

  .promo-banner--has-media .promo-banner__content p {
    color: rgb(255 255 255 / 80%);
  }

  .promo-banner--has-media .promo-badge__pill,
  .promo-banner--has-media .promo-progress__metric,
  .promo-banner--has-media .promo-progress__label,
  .promo-banner--has-media .promo-progress__percent,
  .promo-banner--has-media .promo-countdown__number,
  .promo-banner--has-media .promo-countdown__label {
    color: inherit;
  }

  .promo-banner .button {
    min-width: auto;
    min-height: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: rgb(255 255 255 / 86%);
    box-shadow: none;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .promo-banner .button:hover {
    background: transparent;
    color: #fff;
    transform: none;
  }

  .promo-banner .button::after {
    content: '›';
    margin-left: 0.34em;
    font-size: 1.12em;
    line-height: 0;
  }

  /* ============ Layout styles ============ */

  /* Split — 新品发布：左文右图 */
  .promo-banner--layout-split {
    background: var(--xalgo-cream, #fdfaf7);
  }

  .promo-banner--layout-split .promo-banner__background {
    inset: 0 0 0 50%;
  }

  .promo-banner--layout-split .promo-banner__backdrop {
    background: linear-gradient(90deg, rgb(253 250 247 / 100%) 0%, rgb(253 250 247 / 0%) 18%);
  }

  .promo-banner--layout-split .promo-banner__overlay-card {
    justify-content: flex-start;
  }

  .promo-banner--layout-split .promo-banner__content {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(50%, 620px);
    align-items: flex-start;
    justify-content: center;
    padding: clamp(48px, 8vw, 96px) clamp(20px, 4vw, 64px);
    text-align: left;
    text-shadow: none;
    color: var(--color-foreground);
  }

  .promo-banner--layout-split .promo-banner__content h1,
  .promo-banner--layout-split .promo-banner__content h2 {
    color: var(--color-foreground-heading);
    font-size: clamp(2.6rem, 4.6vw, 4.6rem);
    letter-spacing: -0.04em;
  }

  .promo-banner--layout-split .promo-banner__content p {
    color: var(--color-foreground);
    margin-inline: 0;
  }

  .promo-banner--layout-split .button {
    color: var(--xalgo-gold-deep, #a87c4f);
  }

  .promo-banner--layout-split .button:hover {
    color: var(--color-foreground-heading);
  }

  /* Dark — 众筹/高端发布：深色全屏居中 */
  .promo-banner--layout-dark {
    background: #201a15;
  }

  .promo-banner--layout-dark .promo-banner__backdrop {
    background:
      radial-gradient(circle at 50% 30%, rgb(201 168 130 / 10%) 0%, transparent 55%),
      linear-gradient(180deg, rgb(0 0 0 / 20%) 0%, rgb(0 0 0 / 0%) 40%);
  }

  .promo-banner--layout-dark:not(.promo-banner--has-media) .promo-banner__background {
    background:
      radial-gradient(circle at 50% 22%, rgb(201 168 130 / 14%) 0%, transparent 50%),
      linear-gradient(180deg, #241d17 0%, #1a1511 100%);
  }

  .promo-banner--layout-dark:not(.promo-banner--has-media) .promo-banner__backdrop {
    background: none;
  }

  .promo-banner--layout-dark .promo-banner__content {
    color: #fff;
  }

  .promo-banner--layout-dark .promo-badge__pill {
    border-color: rgb(201 168 130 / 55%);
    color: var(--xalgo-champagne, #c9a882);
  }

  .promo-banner--layout-dark .promo-progress__track {
    background: rgb(255 255 255 / 14%);
  }

  .promo-banner--layout-dark .promo-progress__fill {
    background: var(--xalgo-champagne, #c9a882);
  }

  .promo-banner--layout-dark .button {
    padding: 14px 32px;
    border: 1px solid var(--xalgo-champagne, #c9a882);
    border-radius: 999px;
    background: var(--xalgo-champagne, #c9a882);
    color: #201a15;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
    box-shadow: none;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .promo-banner--layout-dark .button::after {
    content: none;
  }

  .promo-banner--layout-dark .button:hover {
    background: #fff;
    border-color: #fff;
    color: #201a15;
    transform: translateY(-1px);
  }

  .promo-banner--layout-dark .button-secondary {
    padding: 14px 32px;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
    box-shadow: none;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .promo-banner--layout-dark .button-secondary::after {
    content: none;
  }

  .promo-banner--layout-dark .button-secondary:hover {
    background: rgb(255 255 255 / 12%);
    border-color: #fff;
    color: #fff;
    transform: translateY(-1px);
  }

  /* Strip — 大促倒计时：紧凑横幅条 */
  .promo-banner--layout-strip {
    min-height: auto;
    background: linear-gradient(100deg, #b06557 0%, #c9806f 55%, #e8a598 100%);
  }

  .promo-banner--layout-strip .promo-banner__background {
    position: relative;
    inset: auto;
    height: 0;
  }

  .promo-banner--layout-strip .promo-banner__backdrop {
    display: none;
  }

  .promo-banner--layout-strip .promo-banner__container {
    min-height: 0;
  }

  .promo-banner--layout-strip .promo-banner__overlay-card {
    justify-content: center;
  }

  .promo-banner--layout-strip .promo-banner__content {
    position: relative;
    inset: auto;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(20px, 3.4vw, 30px) clamp(20px, 4vw, 64px);
    text-shadow: none;
    color: #fff;
  }

  .promo-banner--layout-strip .promo-banner__content h1,
  .promo-banner--layout-strip .promo-banner__content h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .promo-banner--layout-strip .promo-banner__content p {
    max-width: 30rem;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 85%);
  }

  .promo-banner--layout-strip .promo-progress__track {
    background: rgb(255 255 255 / 30%);
  }

  .promo-banner--layout-strip .promo-progress__fill {
    background: #fff;
  }

  .promo-banner--layout-strip .button {
    padding: 10px 26px;
    border: 1px solid rgb(255 255 255 / 85%);
    border-radius: 999px;
    background: #fff;
    color: #b06557;
  }

  .promo-banner--layout-strip .button::after {
    content: '→';
  }

  .promo-banner--layout-strip .button:hover {
    background: transparent;
    color: #fff;
  }

  @media screen and (max-width: 989px) {
    .promo-banner__upload-prompt {
      right: 5vw;
      bottom: 5vw;
      width: 90vw;
      min-height: 32svh;
      opacity: 0.35;
    }

    .promo-banner__overlay-card,
    .promo-banner--overlay-left .promo-banner__overlay-card,
    .promo-banner--overlay-center .promo-banner__overlay-card,
    .promo-banner--overlay-right .promo-banner__overlay-card {
      justify-content: center;
      text-align: center;
    }

    .promo-banner__content h1,
    .promo-banner__content h2,
    .promo-banner__content p {
      margin-inline: auto;
    }

    .promo-banner__content {
      width: min(100%, 680px);
    }
  }

  @media screen and (max-width: 749px) {
    .promo-banner--layout-split {
      flex-direction: column;
    }

    .promo-banner__overlay-card {
      padding-inline: 22px;
    }

    .promo-banner__content {
      width: 100%;
      padding: 72px 0 32px;
      transform: none;
    }

    .promo-banner__content h1,
    .promo-banner__content h2 {
      max-width: none;
      font-size: clamp(4rem, 18vw, 6.5rem);
      letter-spacing: -0.072em;
    }

    .promo-banner__content p {
      max-width: 20rem;
      font-size: 1.15rem;
    }

    /* Layout-specific mobile overrides (after generic rules) */
    .promo-banner--layout-split .promo-banner__background {
      position: absolute;
      inset: 0;
    }

    .promo-banner--layout-split .promo-banner__backdrop {
      background: linear-gradient(0deg, rgb(253 250 247 / 96%) 22%, rgb(253 250 247 / 0%) 62%);
    }

    .promo-banner--layout-split .promo-banner__content {
      width: 100%;
      justify-content: flex-end;
      padding: 0 22px 40px;
      text-align: left;
    }

    .promo-banner--layout-split .promo-banner__content h1,
    .promo-banner--layout-split .promo-banner__content h2 {
      font-size: clamp(2.6rem, 9vw, 4rem);
      letter-spacing: -0.04em;
    }

    .promo-banner--layout-strip .promo-banner__content {
      flex-direction: column;
      gap: 12px;
      padding: 24px 22px;
    }

    .promo-banner--layout-strip .promo-banner__content h1,
    .promo-banner--layout-strip .promo-banner__content h2 {
      font-size: 1.5rem;
      letter-spacing: -0.02em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "class": "promo-banner-wrapper section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "_promo-countdown"
    },
    {
      "type": "_promo-progress"
    },
    {
      "type": "_promo-badge"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable promo banner",
      "info": "Turn off to hide this section without deleting it.",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "info": "Split = new product launch (text left, image right). Dark = crowdfunding / premium launch. Strip = compact countdown bar for BFCM, Double 11 and other sales.",
      "options": [
        { "value": "full", "label": "Full-screen (current)" },
        { "value": "split", "label": "Split — new launch" },
        { "value": "dark", "label": "Dark — crowdfunding / launch" },
        { "value": "strip", "label": "Strip — sale countdown bar" }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Background hero"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "checkbox",
      "id": "use_default_asset_images",
      "label": "Use processed xGlass scene image",
      "info": "Uses the edited scene photo saved in theme assets. Uploading a background image overrides this.",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop background image",
      "info": "Upload the full campaign poster or product lifestyle image.",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "background_alt",
      "label": "Background image alt text",
      "default": "xGlass campaign hero"
    },
    {
      "type": "range",
      "id": "backdrop_opacity",
      "label": "Backdrop opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "color_background",
      "id": "overlay_card_background",
      "label": "Overlay card background",
      "default": "linear-gradient(135deg, rgba(0,0,0,0.42), rgba(0,0,0,0.18))"
    },
    {
      "type": "select",
      "id": "overlay_position",
      "label": "Overlay position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
