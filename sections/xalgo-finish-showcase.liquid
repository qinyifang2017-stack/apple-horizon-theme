<section
  id="xalgo-finish-showcase-{{ section.id }}"
  class="xalgo-finish-showcase color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="xalgo-finish-showcase__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-finish-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="xalgo-finish-showcase__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="xalgo-finish-showcase__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="xalgo-finish-showcase__carousel" data-finish-carousel>
      <div class="xalgo-finish-showcase__rail" data-finish-rail>
        {%- for block in section.blocks -%}
          <article class="xalgo-finish-showcase__card" {{ block.shopify_attributes }}>
            <div
              class="xalgo-finish-showcase__swatch"
              style="--finish-color: {{ block.settings.color }}; --finish-color-2: {{ block.settings.color_2 }};"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 640
                  | image_tag:
                    class: 'xalgo-finish-showcase__image',
                    widths: '360, 520, 720, 960',
                    sizes: '(min-width: 990px) 24vw, 78vw',
                    alt: block.settings.image.alt
                }}
              {%- else -%}
                <div class="xalgo-finish-showcase__ring" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <div class="xalgo-finish-showcase__copy">
              <h3>{{ block.settings.name }}</h3>
              {%- if block.settings.description != blank -%}
                <p>{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="xalgo-finish-showcase__controls" aria-label="Finish carousel controls">
        <div class="xalgo-finish-showcase__progress" aria-hidden="true">
          <span data-finish-progress></span>
        </div>
        <div class="xalgo-finish-showcase__buttons">
          <button class="xalgo-finish-showcase__control" type="button" aria-label="Previous finishes" data-finish-prev>
            <span aria-hidden="true">←</span>
          </button>
          <button class="xalgo-finish-showcase__control" type="button" aria-label="Next finishes" data-finish-next>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="xalgo-finish-showcase__cta">
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .xalgo-finish-showcase {
    --finish-cream: var(--xalgo-cream, #FDFAF7);
    --finish-rose: var(--xalgo-rose, #E8A598);
    --finish-blush: var(--xalgo-rose-light, #F2DDD8);
    --finish-ink: var(--xalgo-text-primary, #1D1D1F);
    --finish-muted: var(--xalgo-text-secondary, #6E6E73);
    background: linear-gradient(180deg, #fffaf6 0%, var(--finish-cream) 100%);
    overflow: hidden;
  }

  .xalgo-finish-showcase .page-width {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-finish-showcase__header {
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .xalgo-finish-showcase__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--finish-rose);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .xalgo-finish-showcase__heading {
    margin: 0;
    color: var(--finish-ink);
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .xalgo-finish-showcase__subheading {
    margin: 1rem auto 0;
    max-width: 58ch;
    color: var(--finish-muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.65;
  }

  .xalgo-finish-showcase__carousel {
    margin-inline: auto;
  }

  .xalgo-finish-showcase__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 28vw);
    gap: 1.25rem;
    overflow-x: auto;
    overflow-y: visible;
    padding: 0.25rem 0 1.25rem;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .xalgo-finish-showcase__rail::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .xalgo-finish-showcase__rail {
      grid-auto-columns: clamp(280px, 22vw, 340px);
    }
  }

  .xalgo-finish-showcase__controls {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: 1.25rem;
  }

  .xalgo-finish-showcase__progress {
    --finish-progress-width: 18%;
    --finish-progress-left: 0%;
    position: relative;
    flex: 1;
    height: 2px;
    background: color-mix(in srgb, var(--finish-ink) 18%, transparent);
    overflow: hidden;
  }

  .xalgo-finish-showcase__progress span {
    position: absolute;
    inset-block: 0;
    left: var(--finish-progress-left, 0%);
    width: var(--finish-progress-width, 18%);
    background: color-mix(in srgb, var(--finish-ink) 82%, transparent);
    transition: left 0.25s ease, width 0.25s ease;
  }

  .xalgo-finish-showcase__buttons {
    display: flex;
    gap: 0.75rem;
    flex: 0 0 auto;
  }

  .xalgo-finish-showcase__control {
    width: 3rem;
    aspect-ratio: 1;
    border: 0;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--finish-ink) 86%, transparent);
    color: var(--finish-cream);
    cursor: pointer;
    font: inherit;
    font-size: 1.55rem;
    line-height: 1;
    transition: transform 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
  }

  .xalgo-finish-showcase__control:hover {
    transform: translateY(-1px);
    background: var(--finish-ink);
  }

  .xalgo-finish-showcase__control:disabled {
    opacity: 0.38;
    cursor: default;
    transform: none;
  }

  @media screen and (max-width: 749px) {
    .xalgo-finish-showcase__controls {
      align-items: stretch;
      gap: 1rem;
    }

    .xalgo-finish-showcase__control {
      width: 2.75rem;
    }
  }

  .xalgo-finish-showcase__card {
    scroll-snap-align: start;
    border: 1px solid color-mix(in srgb, var(--finish-rose) 22%, transparent);
    border-radius: 28px;
    background: color-mix(in srgb, var(--finish-cream) 88%, #fff);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .xalgo-finish-showcase__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px rgb(201 168 130 / 0.16);
  }

  .xalgo-finish-showcase__swatch {
    height: 220px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 48% 36%, color-mix(in srgb, var(--finish-color) 64%, transparent) 0 4rem, transparent 8rem),
      linear-gradient(145deg, color-mix(in srgb, var(--finish-color) 32%, #fff), color-mix(in srgb, var(--finish-color-2) 42%, #fff));
    overflow: hidden;
  }

  @media screen and (min-width: 990px) {
    .xalgo-finish-showcase__swatch {
      height: 220px;
    }
  }

  .xalgo-finish-showcase__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .xalgo-finish-showcase__ring {
    width: 120px;
    aspect-ratio: 1;
    border-radius: 999px;
    border: 22px solid transparent;
    background:
      linear-gradient(145deg, var(--finish-color), var(--finish-color-2)) border-box;
    mask: linear-gradient(#000 0 0) padding-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    box-shadow: 0 24px 42px rgb(0 0 0 / 0.12);
  }

  .xalgo-finish-showcase__copy {
    padding: 1.2rem 1.3rem 1.35rem;
  }

  .xalgo-finish-showcase__copy h3 {
    margin: 0 0 0.4rem;
    color: var(--finish-ink);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .xalgo-finish-showcase__copy p {
    margin: 0;
    color: var(--finish-muted);
    line-height: 1.55;
    font-size: 0.94rem;
  }

  .xalgo-finish-showcase__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
{% endstylesheet %}

{% javascript %}
  const finishCarousels = document.querySelectorAll('[data-finish-carousel]');

  finishCarousels.forEach((carousel) => {
    const rail = carousel.querySelector('[data-finish-rail]');
    const previousButton = carousel.querySelector('[data-finish-prev]');
    const nextButton = carousel.querySelector('[data-finish-next]');
    const progress = carousel.querySelector('[data-finish-progress]');

    if (!rail || !previousButton || !nextButton || !progress) return;

    const getStep = () => {
      const firstCard = rail.querySelector('.xalgo-finish-showcase__card');
      if (!firstCard) return rail.clientWidth;

      const styles = window.getComputedStyle(rail);
      const gap = parseFloat(styles.columnGap || styles.gap || '0');
      return firstCard.getBoundingClientRect().width + gap;
    };

    const update = () => {
      const maxScroll = Math.max(rail.scrollWidth - rail.clientWidth, 0);
      const scrollLeft = Math.min(Math.max(rail.scrollLeft, 0), maxScroll);
      const visibleRatio = rail.scrollWidth > 0 ? rail.clientWidth / rail.scrollWidth : 1;
      const progressWidth = Math.min(100, Math.max(12, visibleRatio * 100));
      const maxProgressTravel = 100 - progressWidth;
      const progressLeft = maxScroll > 0 ? (scrollLeft / maxScroll) * maxProgressTravel : 0;

      progress.style.setProperty('--finish-progress-width', `${progressWidth}%`);
      progress.style.setProperty('--finish-progress-left', `${progressLeft}%`);
      previousButton.disabled = scrollLeft <= 1;
      nextButton.disabled = scrollLeft >= maxScroll - 1;
    };

    previousButton.addEventListener('click', () => {
      rail.scrollBy({ left: -getStep(), behavior: 'smooth' });
    });

    nextButton.addEventListener('click', () => {
      rail.scrollBy({ left: getStep(), behavior: 'smooth' });
    });

    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Finish Showcase (xalgo)",
  "tag": "section",
  "class": "section-wrapper xalgo-finish-showcase-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Finishes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose the finish that feels like you."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A health device should still look like jewelry."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose your xRing"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "finish",
      "name": "Finish",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Rose"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "A soft warm finish for everyday wear."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#E8A598"
        },
        {
          "type": "color",
          "id": "color_2",
          "label": "Second color",
          "default": "#F2DDD8"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Finish Showcase (xalgo)",
      "category": "Content",
      "blocks": [
        { "type": "finish" },
        { "type": "finish" },
        { "type": "finish" },
        { "type": "finish" }
      ]
    }
  ]
}
{% endschema %}
