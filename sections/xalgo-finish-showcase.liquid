<section
  id="xalgo-finish-showcase-{{ section.id }}"
  class="xalgo-finish-showcase color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="xalgo-finish-showcase__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xalgo-finish-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="xalgo-finish-showcase__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="xalgo-finish-showcase__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="xalgo-finish-showcase__rail">
      {%- for block in section.blocks -%}
        <article class="xalgo-finish-showcase__card" {{ block.shopify_attributes }}>
          <div
            class="xalgo-finish-showcase__swatch"
            style="--finish-color: {{ block.settings.color }}; --finish-color-2: {{ block.settings.color_2 }};"
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 640
                | image_tag:
                  class: 'xalgo-finish-showcase__image',
                  widths: '240, 360, 520, 640',
                  sizes: '(min-width: 990px) 24vw, 78vw',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              <div class="xalgo-finish-showcase__ring" aria-hidden="true"></div>
            {%- endif -%}
          </div>
          <div class="xalgo-finish-showcase__copy">
            <h3>{{ block.settings.name }}</h3>
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="xalgo-finish-showcase__cta">
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .xalgo-finish-showcase {
    --finish-cream: var(--xalgo-cream, #FDFAF7);
    --finish-rose: var(--xalgo-rose, #E8A598);
    --finish-blush: var(--xalgo-rose-light, #F2DDD8);
    --finish-ink: var(--xalgo-text-primary, #1D1D1F);
    --finish-muted: var(--xalgo-text-secondary, #6E6E73);
    background: linear-gradient(180deg, #fffaf6 0%, var(--finish-cream) 100%);
    overflow: hidden;
  }

  .xalgo-finish-showcase .page-width {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .xalgo-finish-showcase__header {
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .xalgo-finish-showcase__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--finish-rose);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .xalgo-finish-showcase__heading {
    margin: 0;
    color: var(--finish-ink);
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .xalgo-finish-showcase__subheading {
    margin: 1rem auto 0;
    max-width: 58ch;
    color: var(--finish-muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.65;
  }

  .xalgo-finish-showcase__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    gap: 1rem;
    overflow-x: auto;
    padding: 0.25rem 0.25rem 1rem;
    scroll-snap-type: x mandatory;
  }

  @media screen and (min-width: 990px) {
    .xalgo-finish-showcase__rail {
      grid-auto-flow: initial;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
    }
  }

  .xalgo-finish-showcase__card {
    scroll-snap-align: center;
    border: 1px solid color-mix(in srgb, var(--finish-rose) 22%, transparent);
    border-radius: 28px;
    background: color-mix(in srgb, var(--finish-cream) 88%, #fff);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .xalgo-finish-showcase__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px rgb(201 168 130 / 0.16);
  }

  .xalgo-finish-showcase__swatch {
    min-height: 220px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 48% 36%, color-mix(in srgb, var(--finish-color) 64%, transparent) 0 4rem, transparent 8rem),
      linear-gradient(145deg, color-mix(in srgb, var(--finish-color) 32%, #fff), color-mix(in srgb, var(--finish-color-2) 42%, #fff));
  }

  .xalgo-finish-showcase__image {
    width: 78%;
    max-width: 260px;
    height: auto;
    filter: drop-shadow(0 24px 32px rgb(0 0 0 / 0.12));
  }

  .xalgo-finish-showcase__ring {
    width: 120px;
    aspect-ratio: 1;
    border-radius: 999px;
    border: 22px solid transparent;
    background:
      linear-gradient(145deg, var(--finish-color), var(--finish-color-2)) border-box;
    mask: linear-gradient(#000 0 0) padding-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    box-shadow: 0 24px 42px rgb(0 0 0 / 0.12);
  }

  .xalgo-finish-showcase__copy {
    padding: 1.2rem 1.3rem 1.35rem;
  }

  .xalgo-finish-showcase__copy h3 {
    margin: 0 0 0.4rem;
    color: var(--finish-ink);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .xalgo-finish-showcase__copy p {
    margin: 0;
    color: var(--finish-muted);
    line-height: 1.55;
    font-size: 0.94rem;
  }

  .xalgo-finish-showcase__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Finish Showcase (xalgo)",
  "tag": "section",
  "class": "section-wrapper xalgo-finish-showcase-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Finishes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose the finish that feels like you."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A health device should still look like jewelry."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose your xRing"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/products/xring"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "finish",
      "name": "Finish",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Rose"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "A soft warm finish for everyday wear."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#E8A598"
        },
        {
          "type": "color",
          "id": "color_2",
          "label": "Second color",
          "default": "#F2DDD8"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Finish Showcase (xalgo)",
      "category": "Content",
      "blocks": [
        { "type": "finish" },
        { "type": "finish" },
        { "type": "finish" },
        { "type": "finish" }
      ]
    }
  ]
}
{% endschema %}
