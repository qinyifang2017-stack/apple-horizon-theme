{% comment %}
  MUSEVE Choose — "Ready to choose your MUSEVE Glasses?" closing purchase nudge.
  Has an on/off switch so prelaunch pages can hide it.
{% endcomment %}

{%- if section.settings.enabled -%}
<section
  id="xalgo-museve-choose-{{ section.id }}"
  class="xalgo-museve-choose color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width xalgo-museve-choose__shell">
    {%- if section.settings.heading != blank -%}
      <h2 class="xalgo-museve-choose__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="xalgo-museve-choose__lede">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        class="xalgo-museve-choose__btn"
        href="{{ section.settings.button_url | default: '/products/glasses' }}"
        {% if section.settings.button_new_window %}target="_blank" rel="noopener"{% endif %}
      >{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .xalgo-museve-choose {
    --muc-cream: var(--xalgo-cream, #fdfaf7);
    --muc-ink: var(--xalgo-text-primary, #1d1d1f);
    --muc-muted: var(--xalgo-text-secondary, #6e6e73);
    --muc-terracotta: var(--xalgo-terracotta, #b06557);
    --muc-rose: var(--xalgo-rose, #e8a598);

    background: var(--muc-cream);
    text-align: center;
  }

  .xalgo-museve-choose__heading {
    margin: 0 auto;
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    font-style: normal;
    text-transform: none;
    color: var(--muc-ink);
    text-wrap: balance;
  }

  .xalgo-museve-choose__lede {
    margin: 1rem auto 0;
    max-width: 420px;
    color: var(--muc-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .xalgo-museve-choose__btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 1.6rem;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    border: 1.5px solid var(--muc-terracotta);
    background: transparent;
    color: #fff;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }

  .xalgo-museve-choose__btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #9f584b;
    transform: translateY(101%);
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .xalgo-museve-choose__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--muc-terracotta);
    border-radius: inherit;
  }

  .xalgo-museve-choose__btn:hover::before { transform: translateY(0); }

  .xalgo-museve-choose__btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgb(176 101 87 / 0.32);
  }

  .xalgo-museve-choose__btn:focus-visible {
    outline: 3px solid var(--muc-rose);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MUSEVE Choose",
  "tag": "section",
  "class": "section-wrapper xalgo-museve-choose-wrapper",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show this section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to choose your MUSEVE Glasses?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pick the frame shape and colorway that fit your daily style — prescription and photochromic lens options are available too."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose your MUSEVE Glasses" },
    { "type": "text", "id": "button_url", "label": "Button URL", "default": "/products/glasses" },
    { "type": "checkbox", "id": "button_new_window", "label": "Open in new window", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "MUSEVE Choose", "category": "Content" }
  ]
}
{% endschema %}
