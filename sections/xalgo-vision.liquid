{% comment %}
  MUSEVE Vision page. The section filename is kept as xalgo-vision so the
  existing page.vision template continues to resolve without template churn.
{% endcomment %}

<section
  id="museve-vision-{{ section.id }}"
  class="museve-vision color-{{ section.settings.color_scheme }}"
  style="
    --mv-padding-top: {{ section.settings.padding_top }}px;
    --mv-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <header class="museve-vision__hero">
    <div class="museve-vision__container">
      <p class="museve-vision__eyebrow">Our Vision</p>
      <h1 class="museve-vision__title">AI, made a natural<br>part of every day.</h1>
      <p class="museve-vision__lede">
        At MUSEVE, we believe great smart glasses should never feel like a device
        strapped to your face. They should be beautiful, light, and comfortable &mdash;
        worth wearing every day &mdash; with AI quietly at your side, ready whenever
        you need it.
      </p>
    </div>
  </header>

  <div class="museve-vision__quote museve-vision__reveal">
    <div class="museve-vision__container museve-vision__container--narrow">
      <p class="museve-vision__quote-text">
        &ldquo;Innovation should not stay a concept. It should blend naturally
        into everyday work and life.&rdquo;
      </p>
      <p class="museve-vision__quote-author">The MUSEVE Founding Team</p>
    </div>
  </div>

  <div class="museve-vision__section" id="about">
    <div class="museve-vision__container museve-vision__reveal">
      <p class="museve-vision__section-label">About MUSEVE</p>
      <h2 class="museve-vision__section-title">Next-generation smart glasses,<br>made for everyday wear.</h2>
      <p class="museve-vision__section-sub">A new consumer electronics brand from Nexgo, Inc.</p>
      <div class="museve-vision__prose">
        <p>
          MUSEVE is built by a group of tech enthusiasts, innovation specialists,
          and seasoned electronics industry veterans. Backed by our parent
          company&rsquo;s 25+ years of electronics manufacturing and product delivery
          experience, we combine proven manufacturing capability,
          fashion-forward aesthetics, cutting-edge technology, next-generation
          AI interaction, and intelligent algorithms.
        </p>
        <p>
          Our goal is simple: to create next-generation smart glasses that are
          genuinely suited to daily wear and measurably improve your efficiency.
        </p>
      </div>
    </div>
  </div>

  <div class="museve-vision__section" id="vision">
    <div class="museve-vision__container museve-vision__reveal">
      <p class="museve-vision__section-label">What We Believe</p>
      <h2 class="museve-vision__section-title">What we stand for.</h2>
      <p class="museve-vision__section-sub">
        From product definition to user experience, every step is guided by
        reliable quality, long-term usability, and real user value.
      </p>

      <div class="museve-vision__values">
        <article class="museve-vision__value">
          <h3 class="museve-vision__value-title">Great glasses first</h3>
          <p class="museve-vision__value-desc">
            Beautiful, light, and comfortable &mdash; worth wearing every day.
            Technology should be a bonus, never a burden. That is where every
            design decision starts.
          </p>
        </article>
        <article class="museve-vision__value">
          <h3 class="museve-vision__value-title">Invisible AI</h3>
          <p class="museve-vision__value-desc">
            AI should not come with a learning curve. It blends into your routine &mdash;
            present when you need it, imperceptible when you do not.
          </p>
        </article>
        <article class="museve-vision__value">
          <h3 class="museve-vision__value-title">Real user value</h3>
          <p class="museve-vision__value-desc">
            We do not stack specs; we solve real problems. Every feature must
            answer one question: does it genuinely make you more efficient?
          </p>
        </article>
        <article class="museve-vision__value">
          <h3 class="museve-vision__value-title">Built to last</h3>
          <p class="museve-vision__value-desc">
            Smart hardware should not be disposable. With dependable quality and
            continuously evolving software, our products are made to stand
            the test of time.
          </p>
        </article>
      </div>
    </div>
  </div>

  <div class="museve-vision__section" id="team">
    <div class="museve-vision__container museve-vision__reveal">
      <p class="museve-vision__section-label">Our Team</p>
      <h2 class="museve-vision__section-title">Diverse backgrounds. One goal.</h2>
      <div class="museve-vision__prose">
        <p>
          Our team brings together talent across engineering, industrial design,
          software algorithms, supply chain management, brand marketing, and
          customer service. From product definition and structural design to
          hardware and software R&amp;D, manufacturing, and user experience &mdash;
          we own every step of the journey.
        </p>
      </div>
      <ul class="museve-vision__disciplines" aria-label="MUSEVE team disciplines">
        <li>Engineering</li>
        <li>Industrial Design</li>
        <li>Software &amp; Algorithms</li>
        <li>Supply Chain</li>
        <li>Brand &amp; Marketing</li>
        <li>Customer Service</li>
      </ul>
    </div>
  </div>

  <div class="museve-vision__section museve-vision__product museve-vision__reveal" id="product">
    <div class="museve-vision__container museve-vision__container--narrow">
      <p class="museve-vision__section-label">Coming Soon</p>
      <h2 class="museve-vision__section-title">MUSEVE Smart Glasses</h2>
      <p class="museve-vision__section-sub">
        Our first consumer electronics product for users worldwide &mdash; where
        lightweight, stylish eyewear design meets AI interaction, smart
        recording, and intelligent information processing.
      </p>
      <ul class="museve-vision__features" aria-label="MUSEVE smart glasses features">
        <li>Thin &amp; Light</li>
        <li>All-Day Battery</li>
        <li>AI Meeting Notes</li>
        <li>Personal AI Assistant</li>
        <li>Simple, Intuitive App</li>
      </ul>
    </div>
  </div>

  <div class="museve-vision__section" id="quality">
    <div class="museve-vision__container museve-vision__reveal">
      <p class="museve-vision__section-label">Manufacturing &amp; Quality</p>
      <h2 class="museve-vision__section-title">Stable. Consistent. Traceable.</h2>
      <div class="museve-vision__prose">
        <p>
          MUSEVE products are manufactured through a mature precision
          manufacturing system, in partnership with Luxshare Precision, under
          strict production management and reliability testing &mdash; delivering
          stable, consistent, and fully traceable quality for every piece of
          smart hardware we ship.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('museve-vision-{{ section.id }}');
    if (!section) return;

    var revealItems = section.querySelectorAll('.museve-vision__reveal');

    if (!('IntersectionObserver' in window)) {
      revealItems.forEach(function (item) {
        item.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    revealItems.forEach(function (item) {
      observer.observe(item);
    });
  })();
</script>

{% stylesheet %}
  .museve-vision {
    --mv-text-primary: #1d1d1f;
    --mv-text-secondary: #5f6268;
    --mv-text-tertiary: #7b7e85;
    --mv-accent: #0066cc;
    --mv-accent-hover: #004499;
    --mv-bg: #ffffff;
    --mv-bg-subtle: #f5f5f7;
    --mv-border: #d2d2d7;

    background: var(--mv-bg);
    color: var(--mv-text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
    line-height: 1.6;
    padding-block: var(--mv-padding-top) var(--mv-padding-bottom);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .museve-vision *,
  .museve-vision *::before,
  .museve-vision *::after {
    box-sizing: border-box;
  }

  .museve-vision a {
    color: var(--mv-accent);
    text-decoration: none;
  }

  .museve-vision a:hover {
    color: var(--mv-accent-hover);
    text-decoration: underline;
  }

  .museve-vision__container {
    max-width: 980px;
    margin-inline: auto;
    padding-inline: 22px;
  }

  .museve-vision__container--narrow {
    max-width: 700px;
  }

  .museve-vision__hero {
    padding-block: 112px 96px;
  }

  .museve-vision__section {
    padding-block: 96px;
  }

  .museve-vision__section + .museve-vision__section {
    border-block-start: 1px solid var(--mv-border);
  }

  .museve-vision__eyebrow,
  .museve-vision__section-label {
    color: var(--mv-accent);
    font-weight: 600;
  }

  .museve-vision__eyebrow {
    margin: 0 0 12px;
    font-size: 19px;
  }

  .museve-vision__title {
    margin: 0 0 28px;
    color: var(--mv-text-primary);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .museve-vision__lede {
    max-width: 760px;
    margin: 0;
    color: var(--mv-text-secondary);
    font-size: clamp(19px, 2.4vw, 24px);
    line-height: 1.5;
  }

  .museve-vision__quote {
    background: var(--mv-bg-subtle);
    padding-block: 110px;
    text-align: center;
  }

  .museve-vision__quote-text {
    max-width: 820px;
    margin: 0 auto 24px;
    color: var(--mv-text-primary);
    font-size: clamp(26px, 4vw, 40px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .museve-vision__quote-author {
    margin: 0;
    color: var(--mv-text-tertiary);
    font-size: 15px;
  }

  .museve-vision__section-label {
    margin: 0 0 14px;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .museve-vision__section-title {
    margin: 0 0 20px;
    color: var(--mv-text-primary);
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .museve-vision__section-sub {
    max-width: 680px;
    margin: 0 0 32px;
    color: var(--mv-text-secondary);
    font-size: 19px;
  }

  .museve-vision__prose p {
    max-width: 700px;
    margin: 0 0 1.2em;
    color: var(--mv-text-primary);
    font-size: 17px;
  }

  .museve-vision__prose p:last-child {
    margin-bottom: 0;
  }

  .museve-vision__values {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 64px;
    margin-block-start: 56px;
  }

  .museve-vision__value-title {
    margin: 0 0 8px;
    color: var(--mv-text-primary);
    font-size: 21px;
    font-weight: 600;
  }

  .museve-vision__value-desc {
    margin: 0;
    color: var(--mv-text-secondary);
    font-size: 15px;
    line-height: 1.65;
  }

  .museve-vision__disciplines,
  .museve-vision__features {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
  }

  .museve-vision__disciplines {
    gap: 10px;
    margin: 36px 0 0;
  }

  .museve-vision__disciplines li {
    border: 1px solid var(--mv-border);
    border-radius: 999px;
    color: var(--mv-text-secondary);
    font-size: 14px;
    padding: 6px 16px;
  }

  .museve-vision__product {
    background: var(--mv-bg-subtle);
    text-align: center;
  }

  .museve-vision__product .museve-vision__section-sub {
    margin-inline: auto;
  }

  .museve-vision__features {
    justify-content: center;
    gap: 12px 40px;
    margin: 40px 0 0;
  }

  .museve-vision__features li {
    min-width: 132px;
    color: var(--mv-text-primary);
    font-size: 17px;
    font-weight: 600;
  }

  .museve-vision__features li::before {
    content: "";
    display: block;
    width: 28px;
    height: 2px;
    margin: 0 auto 12px;
    background: var(--mv-accent);
  }

  .museve-vision__reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .museve-vision__reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 734px) {
    .museve-vision__hero {
      padding-block: 88px 72px;
    }

    .museve-vision__section {
      padding-block: 72px;
    }

    .museve-vision__quote {
      padding-block: 82px;
    }

    .museve-vision__values {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .museve-vision__reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vision (MUSEVE)",
  "tag": "section",
