{% comment %}
  MUSEVE Vision page — layout follows MUSEVE_Our_Vision_EN (site header/footer excluded).
  The section filename is kept as xalgo-vision so the existing page.vision template
  continues to resolve without template churn.
{% endcomment %}

<section
  id="museve-vision-{{ section.id }}"
  class="museve-vision color-{{ section.settings.color_scheme }}"
  style="
    --mv-padding-top: {{ section.settings.padding_top }}px;
    --mv-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="museve-vision__inner">
    <header class="museve-vision__hero">
      <p class="museve-vision__eyebrow">Our Vision</p>
      <h1 class="museve-vision__title">
        Designed to Delight.<br>
        <p>Built to Empower.</p>
      </h1>
      <p class="museve-vision__hero-subtitle">
        Helpful intelligence, built into the things you wear and love.
      </p>
    </header>

    <div class="museve-vision__story museve-vision__reveal">
      <h2 class="museve-vision__story-heading">
        Technology shouldn&rsquo;t demand your attention. It should fit your day.
      </h2>
      <div class="museve-vision__story-copy">
        <p>
          We build tools and objects you naturally reach for&mdash;glasses that quietly amplify
          your work, alongside rings, frames, and badges that express who you are.
        </p>
        <p class="museve-vision__story-close">
          Powerful when needed. Invisible when you&rsquo;re done.
        </p>
      </div>
    </div>

    <div class="museve-vision__principles museve-vision__reveal">
      <article>
        <h3>Style &amp; Comfort First</h3>
        <p>If it doesn&rsquo;t feel great to wear, the technology inside doesn&rsquo;t matter.</p>
      </article>
      <article>
        <h3>Help Without Distraction</h3>
        <p>
          Assistance that shows up in the right moment, then fades back into the background.
        </p>
      </article>
      <article>
        <h3>Real Daily Value</h3>
        <p>No gimmicks. Every feature earns its place by making your routine lighter.</p>
      </article>
      <article>
        <h3>Built to Last</h3>
        <p>Tactile materials and dependable engineering for the long run.</p>
      </article>
    </div>
  </div>

  <div class="museve-vision__band museve-vision__band--soft">
    <div class="museve-vision__inner">
      <div class="museve-vision__section-heading museve-vision__reveal">
        <p class="museve-vision__eyebrow">Our Products</p>
        <h2>Designed around everyday life.</h2>
      </div>

      <div class="museve-vision__product-layout museve-vision__reveal">
        <figure class="museve-vision__product-figure">
          {%- assign product_images = section.blocks | where: 'type', 'product_image' -%}
          {%- if product_images.size > 0 -%}
            <div
              class="museve-vision__carousel"
              data-carousel
              role="group"
              aria-roledescription="carousel"
              aria-label="Product photographs"
            >
              <div class="museve-vision__carousel-track">
                {%- for block in product_images -%}
                  {%- if block.settings.image != blank -%}
                    <div
                      class="museve-vision__slide{% if forloop.first %} is-active{% endif %}"
                      role="group"
                      aria-roledescription="slide"
                      aria-label="{{ forloop.index }} / {{ product_images.size }}{{ block.settings.caption | default: block.settings.image.alt | default: 'Product photograph' | escape }}"
                    >
                      {{
                        block.settings.image
                        | image_url: width: 1400
                        | image_tag:
                          class: 'museve-vision__slide-image',
                          widths: '600, 900, 1200, 1400',
                          sizes: '(min-width: 990px) 42vw, 100vw',
                          alt: block.settings.image.alt,
                          loading: 'lazy'
                      }}
                      {%- if block.settings.caption != blank -%}
                        <figcaption class="museve-vision__slide-caption">
                          {{ block.settings.caption }}
                        </figcaption>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if product_images.size > 1 -%}
                <button
                  type="button"
                  class="museve-vision__carousel-arrow museve-vision__carousel-arrow--prev"
                  data-carousel-prev
                  aria-label="Previous image"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M10 2.5 4.5 8 10 13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button
                  type="button"
                  class="museve-vision__carousel-arrow museve-vision__carousel-arrow--next"
                  data-carousel-next
                  aria-label="Next image"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 2.5 11.5 8 6 13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <div class="museve-vision__carousel-dots" role="tablist" aria-label="Choose image">
                  {%- for block in product_images -%}
                    {%- if block.settings.image != blank -%}
                      <button
                        type="button"
                        role="tab"
                        class="museve-vision__carousel-dot{% if forloop.first %} is-active{% endif %}"
                        data-carousel-dot="{{ forloop.index0 }}"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                        aria-label="Go to image {{ forloop.index }}"
                      ></button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="museve-vision__photo-slot" role="img" aria-label="Product photograph placeholder">
              <div>
                <strong>Product photograph to be added</strong>
                <small>Everyday wear</small>
              </div>
            </div>
          {%- endif -%}
        </figure>
        <div class="museve-vision__product-copy">
          <article>
            <h3>MUSEVE Glasses</h3>
            <p>
              We believe a pair of smart glasses must, first and foremost, be a great pair of
              glasses. We stripped away the unnecessary to focus on what truly matters: ergonomic
              design, honest materials, and timeless aesthetics. It is an exceptional piece of
              eyewear that just happens to be intelligent.
            </p>
          </article>
          <article>
            <h3>MUSEVE Ring</h3>
            <p>
              When designing a smart ring, we didn&rsquo;t start with the microchips; we started
              with the jewelry. Our focus remains entirely on how it looks and feels&mdash;
              prioritizing fluid lines and effortless comfort for all-day wear. It exists
              beautifully as an everyday accessory, keeping its intelligence hidden beneath the
              surface.
            </p>
          </article>
        </div>
      </div>

      <div class="museve-vision__secondary museve-vision__reveal">
        <article>
          <h3>MUSEVE Palette</h3>
          <p class="museve-vision__product-subtitle">Multi-Color E-Paper Frame</p>
          <p>
            An everyday frame for images you want to keep in view. Its design reflects our belief
            that technology should feel at home in your space.
          </p>
        </article>
        <article>
          <h3>Smart badge</h3>
          <p>
            Our smart badge brings personal expression to a familiar accessory. Its design starts
            with how you want to present yourself in everyday life.
          </p>
        </article>
      </div>
    </div>
  </div>

  <div class="museve-vision__inner museve-vision__inner--padded">
    <div class="museve-vision__section-heading museve-vision__reveal">
      <p class="museve-vision__eyebrow">Our Research</p>
      <h2>Where science meets everyday life.</h2>
    </div>

    <div class="museve-vision__research museve-vision__reveal">
      <article>
        <p class="museve-vision__topic">
          MUSEVE Glasses
          <span class="museve-vision__discipline">Consumer Brain&ndash;Computer Interface (BCI)</span>
        </p>
        <h3>Interaction at the speed of thought.</h3>
        <p>
          MUSEVE Glasses is built around one bold ambition: to read your thoughts and turn
          unspoken intent into action. That ambition is driving our research and laboratory
          experiments today&mdash;and shaping a future where your eyewear understands what you
          want to do, the moment you think it.
        </p>
      </article>
      <article>
        <p class="museve-vision__topic">
          MUSEVE Ring
          <span class="museve-vision__discipline">Physiological Signals</span>
        </p>
        <h3>Listening to the body&rsquo;s whispers.</h3>
        <p>
          Your body signals its needs long before you feel them. Our advanced research into
          continuous physiological monitoring aims to decode these silent signals. We are building
          technology designed to know your baseline perfectly, anticipating your health needs
          before you even have to ask.
        </p>
      </article>
      <article>
        <p class="museve-vision__topic">
          Models &amp; Algorithms
          <span class="museve-vision__discipline">In-house R&amp;D</span>
        </p>
        <h3>Built to understand your world.</h3>
        <p>
          We develop our own models and algorithms for imaging, audio processing, and calorie
          estimation. From MUSEVE Palette to future applications across our devices, our research
          aims to help technology understand more, respond naturally, and fit into your
          life&mdash;creating intuitive, personal experiences.
        </p>
      </article>
    </div>
  </div>

  <div class="museve-vision__band museve-vision__band--soft">
    <div class="museve-vision__inner">
      <div class="museve-vision__section-heading museve-vision__reveal">
        <p class="museve-vision__eyebrow">Our Team</p>
        <h2>From idea to everyday use.</h2>
      </div>

      <div class="museve-vision__team museve-vision__reveal">
        <p class="museve-vision__team-copy">
          Our team brings together engineering, design, software, manufacturing, and customer
          support. From the first sketch to the finished product, we work toward the same goal:
          technology people want to use every day.
        </p>
        <div class="museve-vision__team-experience">
          <p class="museve-vision__experience-number">25+</p>
          <p class="museve-vision__experience-note">
            Years of electronics manufacturing and product experience at XGD, our parent group.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('museve-vision-{{ section.id }}');
    if (!section) return;

    var revealItems = section.querySelectorAll('.museve-vision__reveal');

    if (!('IntersectionObserver' in window)) {
      revealItems.forEach(function (item) {
        item.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    revealItems.forEach(function (item) {
      observer.observe(item);
    });
  })();
</script>

<script>
  (function () {
    var section = document.getElementById('museve-vision-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('[data-carousel]').forEach(function (carousel) {
      var slides = Array.prototype.slice.call(carousel.querySelectorAll('.museve-vision__slide'));
      var dots = Array.prototype.slice.call(carousel.querySelectorAll('.museve-vision__carousel-dot'));
      if (slides.length < 2) return;

      var index = 0;
      var timer = null;

      function show(next) {
        slides[index].classList.remove('is-active');
        if (dots[index]) {
          dots[index].classList.remove('is-active');
          dots[index].setAttribute('aria-selected', 'false');
        }
        index = (next + slides.length) % slides.length;
        slides[index].classList.add('is-active');
        if (dots[index]) {
          dots[index].classList.add('is-active');
          dots[index].setAttribute('aria-selected', 'true');
        }
      }

      function startAuto() {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) return;
        stopAuto();
        timer = setInterval(function () {
          show(index + 1);
        }, 5000);
      }

      function stopAuto() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      var prev = carousel.querySelector('[data-carousel-prev]');
      var next = carousel.querySelector('[data-carousel-next]');
      if (prev) prev.addEventListener('click', function () { show(index - 1); startAuto(); });
      if (next) next.addEventListener('click', function () { show(index + 1); startAuto(); });

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          show(parseInt(dot.getAttribute('data-carousel-dot'), 10) || 0);
          startAuto();
        });
      });

      carousel.addEventListener('mouseenter', stopAuto);
      carousel.addEventListener('mouseleave', startAuto);
      carousel.addEventListener('focusin', stopAuto);
      carousel.addEventListener('focusout', startAuto);

      startAuto();
    });
  })();
</script>

{% stylesheet %}
  .museve-vision {
    --mv-paper: #fcfbf8;
    --mv-soft: #efeee8;
    --mv-ink: #252c28;
    --mv-muted: #62685f;
    --mv-gold: #887451;
    --mv-rule: #d7d8cf;

    background: var(--mv-paper);
    color: var(--mv-ink);
    font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
    line-height: 1.6;
    padding-block: var(--mv-padding-top) var(--mv-padding-bottom);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* 主题 base.css 会用字体预设覆盖 h1/h2/h3，这里全部显式复位为原稿样式 */
  .museve-vision,
  .museve-vision :is(p, h1, h2, h3, h4, h5, h6, li, span, strong, small, a) {
    font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
  }

  .museve-vision h1,
  .museve-vision h2,
  .museve-vision h3 {
    font-style: normal;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: var(--mv-ink);
  }

  .museve-vision *,
  .museve-vision *::before,
  .museve-vision *::after {
    box-sizing: border-box;
  }

  .museve-vision p,
  .museve-vision h1,
  .museve-vision h2,
  .museve-vision h3,
  .museve-vision figure {
    margin: 0;
    font-weight: 400;
  }

  .museve-vision__inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 60px;
  }

  .museve-vision__inner--padded {
    padding-block: 68px;
  }

  .museve-vision__band {
    padding-block: 68px;
  }

  .museve-vision__band--soft {
    background: var(--mv-soft);
  }

  /* —— Hero —— */
  .museve-vision__hero {
    padding-block: 7px 53px;
    margin-top: 68px;
    text-align: center;
  }

  .museve-vision__eyebrow {
    color: var(--mv-gold);
    font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.13em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .museve-vision__title {
    margin: 23px auto 0 !important;
    font-size: clamp(44px, 5.2vw, 64px);
    letter-spacing: -0.05em;
    line-height: 1.08;
    text-wrap: balance;
  }

  /* 桌面端锁定 64px，避免窗口宽度不足时标题比设计稿显小 */
  @media screen and (min-width: 1001px) {
    .museve-vision__title {
      font-size: 64px;
    }
  }

  .museve-vision__title p {
    color: var(--mv-gold);
    font-style: normal;
    margin-top: 10px;
  }

  .museve-vision__hero-subtitle {
    margin: 23px auto 0 !important;
    color: var(--mv-muted);
    font-size: 19px;
    line-height: 1.6;
    text-wrap: balance;
  }

  /* —— Story —— */
  .museve-vision__story {
    display: grid;
    grid-template-columns: 1fr 1.16fr;
    gap: 66px;
    align-items: start;
    border-block-start: 1px solid var(--mv-rule);
    padding-block-start: 34px;
  }

  .museve-vision__story-heading {
    font-size: 30px;
    letter-spacing: -0.03em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .museve-vision__story-copy p {
    color: var(--mv-muted);
    font-size: 17px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .museve-vision__story-close {
    margin-top: 19px !important;
    color: var(--mv-gold) !important;
    font-size: 18px !important;
    line-height: 1.45 !important;
  }

  /* —— Principles —— */
  .museve-vision__principles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-block-start: 39px;
    margin-bottom: 68px;
  }

  .museve-vision__principles article {
    min-width: 0;
    padding: 22px 21px 24px;
    background: #f3f1eb;
    border: 1px solid #e3e1d9;
    border-radius: 4px;
  }

  .museve-vision__principles h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
    min-height: 2.6em;
    text-wrap: balance;
  }

  .museve-vision__principles p {
    color: var(--mv-muted);
    font-size: 14px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* —— Section headings —— */
  .museve-vision__section-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 32px;
  }

  .museve-vision__section-heading h2 {
    max-width: 960px;
    font-size: clamp(32px, 3.2vw, 40px);
    letter-spacing: -0.035em;
    line-height: 1.16;
    text-wrap: balance;
  }

  /* —— Products —— */
  .museve-vision__product-layout {
    display: grid;
    grid-template-columns: 1fr 1.16fr;
    gap: 66px;
    align-items: center;
  }

  .museve-vision__product-figure {
    align-self: stretch;
    min-width: 0;
  }

  .museve-vision__photo-slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    height: 100%;
    padding: 25px;
    background: #e2dfd5;
    border-radius: 10px;
    color: #7a7a6c;
    text-align: center;
  }

  .museve-vision__photo-slot::before {
    content: '';
    position: absolute;
    inset: 15px;
    border: 1px solid #cfcdc1;
    border-radius: 4px;
  }

  .museve-vision__photo-slot strong {
    display: block;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .museve-vision__photo-slot small {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    line-height: 1.5;
  }

  /* —— Product image carousel —— */
  .museve-vision__carousel {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #e2dfd5;
  }

  .museve-vision__carousel-track {
    display: grid;
  }

  .museve-vision__slide {
    position: relative;
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0.5s;
  }

  .museve-vision__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .museve-vision__slide-image {
    display: block;
    width: 100%;
    min-height: 300px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .museve-vision__slide-caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 24px 18px 14px;
    background: linear-gradient(to top, rgb(20 18 14 / 42%), transparent);
    color: #fff;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  .museve-vision__carousel-arrow {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    padding: 0;
    background: rgb(252 251 248 / 82%);
    border: 0;
    border-radius: 50%;
    color: #252c28;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.25s ease, background-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .museve-vision__carousel:hover .museve-vision__carousel-arrow,
  .museve-vision__carousel-arrow:focus-visible {
    opacity: 1;
  }

  .museve-vision__carousel-arrow:hover {
    background: #fcfbf8;
  }

  .museve-vision__carousel-arrow--prev {
    left: 14px;
  }

  .museve-vision__carousel-arrow--next {
    right: 14px;
  }

  .museve-vision__carousel-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    display: flex;
    gap: 7px;
    transform: translateX(-50%);
  }

  .museve-vision__carousel-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    background: rgb(252 251 248 / 55%);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .museve-vision__carousel-dot.is-active {
    background: #fcfbf8;
    transform: scale(1.25);
  }

  @media (hover: none) {
    .museve-vision__carousel-arrow {
      display: none;
    }
  }

  .museve-vision__product-copy article + article {
    margin-top: 26px;
    padding-top: 24px;
    border-top: 1px solid #d0d1c8;
  }

  .museve-vision__product-copy h3 {
    margin-bottom: 11px;
    font-size: 25px;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .museve-vision__product-copy p {
    max-width: 515px;
    color: var(--mv-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .museve-vision__secondary {
    display: grid;
    grid-template-columns: 1fr 1.16fr;
    gap: 66px;
    margin-top: 43px;
  }

  .museve-vision__secondary article {
    padding-top: 26px;
    border-top: 1px solid #d0d1c8;
  }

  .museve-vision__secondary h3 {
    margin-bottom: 12px;
    font-size: 24px;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .museve-vision__secondary p {
    max-width: 470px;
    color: var(--mv-muted);
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .museve-vision__product-subtitle {
    margin: -4px 0 13px !important;
    color: var(--mv-gold) !important;
    font-size: 14px !important;
    font-style: italic;
    line-height: 1.5 !important;
  }

  /* —— Research —— */
  .museve-vision__research {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }

  .museve-vision__research article {
    min-width: 0;
    padding: 27px 25px 30px;
    border: 1px solid var(--mv-rule);
    border-radius: 4px;
  }

  .museve-vision__topic {
    color: var(--mv-gold);
    font-size: 12px;
    letter-spacing: 0.015em;
    line-height: 1.6;
  }

  .museve-vision__discipline {
    display: block;
    margin-top: 5px;
    font-size: 10px;
    letter-spacing: 0.095em;
    text-transform: uppercase;
  }

  .museve-vision__research h3 {
    max-width: 270px;
    margin: 22px 0 17px;
    font-size: 26px;
    letter-spacing: -0.035em;
    line-height: 1.2;
    min-height: 2.4em;
    text-wrap: balance;
  }

  .museve-vision__research p:last-child {
    color: var(--mv-muted);
    font-size: 15px;
    line-height: 1.75;
    text-wrap: pretty;
  }

  /* —— Team —— */
  .museve-vision__team {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 10%;
    align-items: center;
    margin-bottom: 68px;
  }

  .museve-vision__team-copy {
    max-width: 610px;
    color: var(--mv-muted);
    font-size: 18px;
    line-height: 1.75;
  }

  .museve-vision__team-experience {
    border-left: 1px solid #d0d1c8;
    padding-left: 36px;
  }

  .museve-vision__experience-number {
    color: var(--mv-gold);
    font-size: 82px;
    font-variant-numeric: lining-nums;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .museve-vision__experience-note {
    max-width: 235px;
    margin-top: 15px;
    color: var(--mv-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  /* —— Reveal —— */
  .museve-vision__reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .museve-vision__reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  /* —— Responsive —— */
  @media screen and (max-width: 1000px) {
    .museve-vision__inner {
      padding-inline: 40px;
    }

    .museve-vision__product-layout,
    .museve-vision__secondary,
    .museve-vision__story {
      gap: 40px;
    }

    .museve-vision__principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .museve-vision__principles h3 {
      min-height: 0;
    }

    .museve-vision__research {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .museve-vision__research article {
      padding: 25px 28px;
    }

    .museve-vision__research h3 {
      max-width: none;
      margin: 16px 0;
      min-height: 0;
      font-size: 28px;
    }

    .museve-vision__research p:last-child {
      max-width: 740px;
    }

    .museve-vision__team {
      gap: 7%;
    }

    .museve-vision__team-experience {
      padding-left: 27px;
    }
  }

  @media screen and (max-width: 640px) {
    .museve-vision__inner {
      padding-inline: 25px;
    }

    .museve-vision__band {
      padding-block: 39px;
    }

    .museve-vision__hero {
      margin-top: 39px;
      padding-block: 3px 35px;
    }

    .museve-vision__title {
      font-size: clamp(30px, 8.6vw, 44px);
      line-height: 1.12;
      margin-top: 20px;
    }

    .museve-vision__hero-subtitle {
      font-size: 16px;
      max-width: 350px;
      margin-top: 20px;
    }

    .museve-vision__story {
      grid-template-columns: 1fr;
      gap: 22px;
      padding-block-start: 28px;
    }

    .museve-vision__story-heading {
      font-size: 27px;
      max-width: 440px;
      line-height: 1.3;
    }

    .museve-vision__story-copy p {
      font-size: 15px;
    }

    .museve-vision__story-close {
      font-size: 17px !important;
      margin-top: 17px !important;
    }

    .museve-vision__principles {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-block-start: 29px;
      margin-bottom: 39px;
    }

    .museve-vision__principles article {
      padding: 21px 20px;
    }

    .museve-vision__principles h3 {
      font-size: 18px;
      min-height: 0;
      margin-bottom: 9px;
    }

    .museve-vision__principles p {
      font-size: 14px;
      max-width: 410px;
    }

    .museve-vision__section-heading {
      gap: 11px;
      margin-bottom: 27px;
    }

    .museve-vision__section-heading h2 {
      font-size: 32px;
      max-width: 360px;
    }

    .museve-vision__product-layout {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
    }

    .museve-vision__product-copy {
      order: 1;
    }

    .museve-vision__product-figure {
      order: 2;
    }

    .museve-vision__photo-slot {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }

    .museve-vision__slide-image {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }

    .museve-vision__product-copy article + article {
      margin-top: 22px;
      padding-top: 22px;
    }

    .museve-vision__product-copy h3 {
      font-size: 24px;
    }

    .museve-vision__product-copy p {
      font-size: 15px;
    }

    .museve-vision__secondary {
      grid-template-columns: 1fr;
      gap: 26px;
      margin-top: 29px;
    }

    .museve-vision__secondary article {
      padding-top: 23px;
    }

    .museve-vision__secondary h3 {
      font-size: 23px;
      margin-bottom: 11px;
    }

    .museve-vision__secondary p {
      font-size: 15px;
    }

    .museve-vision__research {
      gap: 22px;
      margin-bottom: 39px;
    }

    .museve-vision__research article {
      padding: 23px 21px 26px;
    }

    .museve-vision__research h3 {
      font-size: 26px;
      max-width: 360px;
      margin: 18px 0 15px;
      min-height: 0;
    }

    .museve-vision__research p:last-child {
      font-size: 15px;
      line-height: 1.65;
    }

    .museve-vision__team {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: 39px;
    }

    .museve-vision__team-copy {
      font-size: 16px;
    }

    .museve-vision__team-experience {
      display: grid;
      grid-template-columns: 105px 1fr;
      gap: 22px;
      align-items: center;
      border-left: 0;
      border-top: 1px solid #d0d1c8;
      padding: 24px 0 0;
    }

    .museve-vision__experience-number {
      font-size: 67px;
    }

    .museve-vision__experience-note {
      margin-top: 0;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .museve-vision__reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

