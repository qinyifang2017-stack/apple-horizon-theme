{% comment %}
  xalgo FAQ — 分类 Tabs + 折叠问答
  每个 block 是一条 FAQ，通过 category 字段自动分组到对应 Tab
{% endcomment %}

{%- liquid
  assign categories_order = 'product,order,shipping,returns,support' | split: ','
  assign category_labels = 'Product,Orders,Shipping,Returns & Warranty,Support' | split: ','
  assign active_categories_str = ''

  for block in section.blocks
    assign cat = block.settings.category
    unless active_categories_str contains cat
      if active_categories_str == ''
        assign active_categories_str = cat
      else
        assign active_categories_str = active_categories_str | append: ',' | append: cat
      endif
    endunless
  endfor

  assign active_categories = active_categories_str | split: ','
-%}

<section
  id="xalgo-faq-{{ section.id }}"
  class="xalgo-faq"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="xalgo-faq__header">
        <h1 class="xalgo-faq__heading">{{ section.settings.heading }}</h1>
        {%- if section.settings.subheading != blank -%}
          <p class="xalgo-faq__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if active_categories.size > 1 -%}
      <div class="xalgo-faq__tabs" role="tablist">
        {%- assign first_tab_set = false -%}
        {%- for cat in categories_order -%}
          {%- if active_categories contains cat -%}
            <input
              type="radio"
              name="faq-tab-{{ section.id }}"
              id="faq-tab-{{ section.id }}-{{ cat }}"
              class="xalgo-faq__tab-input"
              {% unless first_tab_set %}
                checked
              {% endunless %}
            >
            {%- for label_cat in categories_order -%}
              {%- if label_cat == cat -%}
                <label
                  class="xalgo-faq__tab-label"
                  for="faq-tab-{{ section.id }}-{{ cat }}"
                  role="tab"
                >
                  {{- category_labels[forloop.index0] -}}
                </label>
              {%- endif -%}
            {%- endfor -%}
            {%- assign first_tab_set = true -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="xalgo-faq__panels">
      {%- for cat in categories_order -%}
        {%- if active_categories contains cat -%}
          <div
            class="xalgo-faq__panel"
            id="faq-panel-{{ section.id }}-{{ cat }}"
            role="tabpanel"
          >
            <div class="xalgo-faq__list">
              {%- for block in section.blocks -%}
                {%- if block.settings.category == cat -%}
                  <details class="xalgo-faq__item" {{ block.shopify_attributes }}>
                    <summary class="xalgo-faq__question">
                      <span>{{ block.settings.question }}</span>
                      <svg
                        class="xalgo-faq__icon"
                        width="20"
                        height="20"
                        viewBox="0 0 20 20"
                        fill="none"
                      >
                        <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <div class="xalgo-faq__answer">
                      {{ block.settings.answer }}
                    </div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('xalgo-faq-{{ section.id }}');
    if (!section) return;
    var hash = window.location.hash.replace('#', '');
    if (!hash) return;
    var input = document.getElementById('faq-tab-{{ section.id }}-' + hash);
    if (input) input.checked = true;
  })();
</script>

{% stylesheet %}
  .xalgo-faq {
    background-color: #fafaf8;
  }

  .xalgo-faq .page-width {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  @media screen and (min-width: 750px) {
    .xalgo-faq .page-width {
      padding-inline: 40px;
    }
  }

  .xalgo-faq__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .xalgo-faq__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }

  .xalgo-faq__subheading {
    font-size: 1rem;
    opacity: 0.7;
    margin: 0;
  }

  /* Tabs */
  .xalgo-faq__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .xalgo-faq__tab-input {
    display: none;
  }

  .xalgo-faq__tab-label {
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.12);
    color: inherit;
  }
  .xalgo-faq__tab-label:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .xalgo-faq__tab-input:checked + .xalgo-faq__tab-label {
    background: #1a1a1a;
    color: #fff;
    border-color: #1a1a1a;
  }

  /* Panels — show/hide via CSS :has() */
  .xalgo-faq__panel {
    display: none;
  }

  .xalgo-faq__panel:first-child {
    display: block;
  }

  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(1):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel {
    display: none;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(1):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel:nth-child(1) {
    display: block;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(2):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel {
    display: none;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(2):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel:nth-child(2) {
    display: block;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(3):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel {
    display: none;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(3):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel:nth-child(3) {
    display: block;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(4):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel {
    display: none;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(4):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel:nth-child(4) {
    display: block;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(5):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel {
    display: none;
  }
  .xalgo-faq__tabs:has(.xalgo-faq__tab-input:nth-of-type(5):checked)
    ~ .xalgo-faq__panels
    .xalgo-faq__panel:nth-child(5) {
    display: block;
  }

  /* Accordion items */
  .xalgo-faq__item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .xalgo-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .xalgo-faq__question:hover {
    color: var(--color-foreground-heading);
  }

  .xalgo-faq__question:hover .xalgo-faq__icon {
    color: var(--xalgo-champagne, #c9a882);
  }

  .xalgo-faq__question::-webkit-details-marker {
    display: none;
  }

  .xalgo-faq__question::marker {
    display: none;
    content: '';
  }
  .xalgo-faq__icon {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .xalgo-faq__item[open] .xalgo-faq__icon {
    transform: rotate(180deg);
  }

  .xalgo-faq__answer {
    padding: 0 0 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    opacity: 0.75;
  }

  .xalgo-faq__answer p {
    margin: 0 0 0.75rem;
  }

  .xalgo-faq__answer p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ (xalgo)",
  "tag": "section",
  "class": "section-wrapper xalgo-faq-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find answers to common questions"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "product", "label": "Product" },
            { "value": "order", "label": "Orders" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns & Warranty" },
            { "value": "support", "label": "Support" }
          ],
          "default": "product"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does this work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Here is the answer to your question.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ (xalgo)",
      "category": "Content",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "category": "product",
            "question": "What is xRing made of?",
            "answer": "<p>xRing is crafted from aerospace-grade titanium, making it lightweight, durable, and hypoallergenic.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "product",
            "question": "How long does the battery last?",
            "answer": "<p>xRing lasts 5-8 days on a single charge depending on usage patterns.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "shipping",
            "question": "How long does shipping take?",
            "answer": "<p>Standard shipping takes 5-7 business days. Express shipping is available for 2-3 business days delivery.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "returns",
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day return policy. Items must be in original condition with packaging.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
