        "box_heading": "In the box",
        "box_items": "<p>MUSEVE Glasses</p><p>Charging case</p><p>Lens cleaning cloth</p><p>Quick start guide & digital warranty card</p>",
        "color_scheme": "scheme-1",
        "padding_top": 104,
