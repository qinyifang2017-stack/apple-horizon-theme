      "block_order": ["tab_blink", "tab_clench", "tab_nod", "tab_shake", "tab_voice", "step_control", "step_capture", "step_organize", "step_review"],
      "name": "How it works",
      "settings": {
        "eyebrow": "How it works",
        "heading": "Silent when you need\nVoice when you want",
        "text": "Blink, clench, nod, shake — or just speak. Then decide what each one does, once, in the MUSEVE app.",
        "color_scheme": "scheme-1",
        "padding_top": 104,
        "padding_bottom": 104
      }
