    "museve_lead": {
      "type": "xalgo-museve-lead",
      "name": "Inside the frame",
      "settings": {
        "eyebrow": "Inside the frame",
        "heading": "Everything hides in the temples",
        "text": "No camera on the front. No screen in the lens. The sensors, microphones and battery all live inside the temples, so what people see is a pair of glasses.",
        "button_label": "View tech specs",
        "button_url": "#xalgo-museve-specs",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "museve_control": {
      "type": "xalgo-museve-control",
      "blocks": {
        "scene_meeting": {
          "type": "scene",
          "settings": { "label": "09:42 · Meeting", "heading": "The decision everyone forgot.", "text": "Key points and action items, captured while you listen." }
        },
        "scene_idea": {
          "type": "scene",
          "settings": { "label": "11:17 · A new idea", "heading": "The thought you had on the way.", "text": "Say it once. It's in your timeline." }
        },
        "scene_class": {
          "type": "scene",
          "settings": { "label": "15:36 · Class", "heading": "The lecture that went too fast.", "text": "Full notes, ready to review by dinner." }
        }
      },
      "block_order": ["scene_meeting", "scene_idea", "scene_class"],
      "name": "Never lose a thought",
      "settings": {
        "eyebrow": "Never lose a thought",
        "heading": "Every day is full of things\nyou wish you'd kept",
        "text": "Ideas, decisions, little moments — gone before you find a pen. Now a blink keeps them.",
        "chip_tag": "Capturing",
        "chip_text": "Meeting — 09:42",
        "color_scheme": "scheme-1",
        "padding_top": 104,
        "padding_bottom": 104
      }
