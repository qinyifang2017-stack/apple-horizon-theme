      "settings": {
        "eyebrow": "Designed for every style",
        "heading": "Real glasses first",
        "text": "Four shapes, your colors, your prescription — in 24 g of pure titanium and acetate. The electronics hide in the temples.",
        "callout_text": "Photochromic lenses come standard — clear indoors, tinted outdoors.",
        "frame_colors_label": "Frame colors",
        "temple_finishes_label": "Temple finishes",
        "color_scheme": "scheme-1",
