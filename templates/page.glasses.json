      "type": "xalgo-faq",
      "blocks": {
        "faq_launch": {
          "type": "faq_item",
          "settings": {
            "category": "product",
            "question": "When does it launch on Kickstarter?",
            "answer": "<p>Subscribers hear first — and get 24 hours at the Super Early Bird price before anyone else.</p>"
          }
        },
        "faq_cost": {
          "type": "faq_item",
          "settings": {
            "category": "product",
            "question": "How much will it cost?",
            "answer": "<p>Backers get the lowest price we'll ever offer. Sign up and it lands in your inbox before launch.</p>"
          }
        },
        "faq_rx": {
          "type": "faq_item",
          "settings": {
            "category": "product",
            "question": "Can I use my prescription?",
            "answer": "<p>Yes — 1.56 to 1.74 index, with a valid prescription. Photochromic lenses come standard.</p>"
          }
        },
        "faq_camera": {
          "type": "faq_item",
          "settings": {
            "category": "product",
            "question": "Is there really no camera?",
            "answer": "<p>Really. Microphones and speakers only. An LED and a tone show whenever it's listening.</p>"
          }
        },
        "faq_who": {
          "type": "faq_item",
          "settings": {
            "category": "support",
            "question": "Who makes MUSEVE?",
            "answer": "<p>MUSEVE is built by Xalgo, part of XGD — 25 years of electronics manufacturing, from concept to mass production.</p>"
          }
        },
        "faq_commit": {
          "type": "faq_item",
          "settings": {
            "category": "support",
            "question": "Does signing up commit me to anything?",
            "answer": "<p>No. Just an email. Unsubscribe anytime.</p>"
          }
        }
      },
