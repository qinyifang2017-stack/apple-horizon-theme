            "eyebrow": "Financial-grade encryption",
            "heading": "Locked like your bank.",
            "text": "Your notes and transcripts are encrypted on the glasses, in transit and in the cloud."
          }
        },
        "pcard_visible": {
          "type": "pcard",
          "settings": {
            "eyebrow": "Visible listening",
            "heading": "Everyone can see when it's on.",
            "text": "An LED and a tone mark every start and stop."
