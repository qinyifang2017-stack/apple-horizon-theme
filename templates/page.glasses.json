    "museve_how": {
      "type": "xalgo-museve-how",
      "blocks": {
        "step_control": {
          "type": "step",
          "settings": { "icon": "eye", "number": "01", "heading": "Control", "text": "A blink, a clench, a nod — or just say it." }
        },
        "step_capture": {
          "type": "step",
          "settings": { "icon": "mic", "number": "02", "heading": "Capture", "text": "Meetings, ideas, lectures — without touching your phone." }
        },
        "step_organize": {
          "type": "step",
          "settings": { "icon": "sparkle", "number": "03", "heading": "Organize", "text": "AI turns the audio into notes, to-dos and mind maps." }
        },
        "step_review": {
          "type": "step",
          "settings": { "icon": "phone", "number": "04", "heading": "Review", "text": "Every moment becomes a Memory Card on your timeline — searchable." }
        },
        "tab_blink": { "type": "gesture_tab", "settings": { "icon": "eye", "label": "Blink" } },
        "tab_clench": { "type": "gesture_tab", "settings": { "icon": "nod", "label": "Clench" } },
        "tab_nod": { "type": "gesture_tab", "settings": { "icon": "nod", "label": "Nod" } },
        "tab_shake": { "type": "gesture_tab", "settings": { "icon": "shake", "label": "Shake" } },
        "tab_voice": { "type": "gesture_tab", "settings": { "icon": "mic", "label": "Voice" } }
