    "museve_privacy": {
      "type": "xalgo-museve-privacy",
      "blocks": {
        "check_nocam": { "type": "check", "settings": { "text": "No camera on board" } },
        "check_never": { "type": "check", "settings": { "text": "Audio is never recorded or stored" } },
        "check_locked": { "type": "check", "settings": { "text": "Audio cannot be accessed — by anyone" } },
        "pcard_encrypt": {
          "type": "pcard",
          "settings": { "eyebrow": "Financial-grade encryption", "heading": "Locked like your bank.", "text": "Your notes and transcripts are encrypted on the glasses, in transit and in the cloud." }
        },
        "pcard_visible": {
          "type": "pcard",
          "settings": { "eyebrow": "Visible listening", "heading": "Everyone can see when it's on.", "text": "An LED and a tone mark every start and stop." }
        },
        "pcard_wake": {
          "type": "pcard",
          "settings": { "eyebrow": "On-device wake", "heading": "Nothing leaves before you say so.", "text": "Wake-word runs on the glasses. Nothing uploads before activation." }
        },
        "pcard_data": {
          "type": "pcard",
          "settings": { "eyebrow": "Your data, your call", "heading": "Edit, export or delete.", "text": "Every transcript is yours to keep — or erase." }
        }
      },
      "block_order": ["check_nocam", "check_never", "check_locked", "pcard_encrypt", "pcard_visible", "pcard_wake", "pcard_data"],
      "name": "Privacy",
      "settings": {
        "eyebrow": "Camera-free. Privacy-first.",
        "heading": "No camera\nNothing to hide",
        "text": "Welcome in the rooms camera glasses aren't — boardrooms, gyms, locker rooms. What it hears is transcribed, never kept, and locked with financial-grade encryption.",
        "guarantee_label": "Our guarantee",
        "note_text": "Microphones can pick up nearby voices — let people know when it's listening.",
        "color_scheme": "scheme-1",
        "padding_top": 104,
        "padding_bottom": 104
      }
    },
    "museve_specs": {
      "type": "xalgo-tech-specs",
      "blocks": {
        "spec_design": {
          "type": "spec_group",
          "settings": {
            "icon": "size",
            "heading": "Design",
            "details": "<p><strong>Weight</strong> 24 g — with standard lenses; varies by frame shape and prescription</p><p><strong>Frame shapes</strong> Wellington, Boston, Panto, Browline</p><p><strong>Frame colors</strong> To be announced</p><p><strong>Temple finishes</strong> Dark Brown, Silver, Gunmetal, Light Gold, Matte Black</p><p><strong>Materials</strong> Pure titanium (TA1, Grade 1 class) temples and bridge; cellulose acetate front</p><p><strong>Hinges</strong> German-made OBE hinges</p><p><strong>Fit</strong> 51□20–145 mm — varies slightly by shape</p>"
          }
        },
        "spec_lenses": {
          "type": "spec_group",
          "settings": {
            "icon": "materials",
            "heading": "Lenses",
            "details": "<p><strong>Standard lenses</strong> Photochromic — clear indoors, darkens outdoors</p><p><strong>Prescription</strong> Supported, 1.56–1.74 index</p><p><strong>Optional coatings</strong> UV protection, anti-reflective, anti-fingerprint, blue-light filtering</p>"
          }
        },
        "spec_controls": {
          "type": "spec_group",
          "settings": {
            "icon": "sensor",
            "heading": "Controls",
            "details": "<p><strong>Eye movement</strong> EOG sensing</p><p><strong>Facial muscles</strong> fEMG sensing</p><p><strong>Brain activity</strong> EEG sensing</p><p><strong>Electrodes</strong> 8, hidden in the frame</p><p><strong>Motion</strong> 6-axis IMU</p>"
          }
        },
        "spec_audio": {
          "type": "spec_group",
          "settings": {
            "icon": "sensor",
            "heading": "Audio",
            "details": "<p><strong>Microphones</strong> 4 × digital array + 1 × analog</p><p><strong>Speakers</strong> 2 × built-in</p><p><strong>Camera</strong> None</p>"
          }
        },
        "spec_connectivity": {
          "type": "spec_group",
          "settings": {
            "icon": "connectivity",
            "heading": "Connectivity & app",
            "details": "<p><strong>Wireless</strong> Bluetooth Low Energy 5.4</p><p><strong>App</strong> MUSEVE app — iOS, Android, Windows & macOS</p>"
          }
        },
        "spec_battery": {
          "type": "spec_group",
          "settings": {
            "icon": "battery",
            "heading": "Battery & charging",
            "details": "<p><strong>Battery life</strong> Up to 12 h with all features on; over 24 h in typical use</p><p><strong>Charging case</strong> 6–8 full recharges, USB-C</p><p><strong>Water & dust</strong> IPX4</p>"
          }
        }
      },
      "block_order": ["spec_design", "spec_lenses", "spec_controls", "spec_audio", "spec_connectivity", "spec_battery"],
      "name": "Tech specs",
      "settings": {
        "anchor_id": "xalgo-museve-specs",
        "eyebrow": "Inside the frame",
        "heading": "Tech specs",
        "subheading": "Eight electrodes, five microphones and a full day of battery, inside frames that weigh 24 g. Here is every number.",
