    "xglass_specs": {
      "type": "xalgo-tech-specs",
      "blocks": {
        "spec_audio": {
          "type": "spec_group",
          "settings": {
            "icon": "sensor",
            "heading": "Audio and sensing",
            "details": "<p>4 × digital array microphones + 1 × analog microphone with noise reduction and beamforming</p><p>Speaker recognition labels different voices in transcripts</p><p>256 MB local storage keeps about 72 hours of audio before sync</p><p>2 × built-in speakers for calls and prompts</p>"
          }
        },
        "spec_controls": {
          "type": "spec_group",
          "settings": {
            "icon": "compatibility",
            "heading": "Silent controls",
            "details": "<p>Eye-gesture control (EOG) and facial-muscle control (fEMG) — hands-free commands nobody else can hear</p><p>Voice wake with a customizable phrase; detection runs locally on the device</p><p>6-axis IMU and wear detection wake the glasses when you put them on and sleep them when you take them off</p>"
          }
        },
        "spec_connectivity": {
          "type": "spec_group",
          "settings": {
            "icon": "connectivity",
            "heading": "Connectivity and app",
            "details": "<p>Bluetooth Low Energy 5.4 plus classic Bluetooth for pairing and calls</p><p>Audio is cached locally first, then processed by cloud AI when a connection is available</p><p>Review, edit and share everything in the Museve app on iOS and Android</p>"
          }
        },
        "spec_fit": {
          "type": "spec_group",
          "settings": {
            "icon": "size",
            "heading": "Frame and fit",
            "details": "<p>Four silhouettes — Browline, Panto, Boston and Wellington — with 145 mm temples</p><p>Cellulose acetate front, titanium-alloy + TR90 temples, German-made OBE hinges</p><p>About 19.4 g fully assembled, with integrated nose pads</p><p>IPX4 / IP65 dust and water resistance (final rating pending testing)</p>"
          }
        },
        "spec_battery": {
          "type": "spec_group",
          "settings": {
            "icon": "battery",
            "heading": "Battery and charging",
            "details": "<p>Up to 12 hours with all features on; more than 24 hours in typical mixed use</p><p>About 30 minutes in the case for 80% charge</p><p>Magnetic charging case (1,200 mAh, USB-C) adds roughly 6–8 full charges</p>"
          }
        },
        "spec_lenses": {
          "type": "spec_group",
          "settings": {
            "icon": "materials",
            "heading": "Lens options",
            "details": "<p>Photochromic lenses come standard — clear indoors, tinted outdoors</p><p>Optional UV, anti-reflective, anti-fingerprint and blue-light-filtering coatings</p><p>Prescription lenses in 1.56, 1.60, 1.67 or 1.74 index, matched to your prescription</p>"
          }
        }
