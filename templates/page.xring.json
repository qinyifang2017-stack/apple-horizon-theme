      "type": "xalgo-product-story",
      "blocks": {
        "sensing_point_1": {
          "type": "point",
          "settings": {
            "heading": "Cross-calibrated sensors",
            "text": "<p>Infrared LEDs, green LEDs, temperature sensors and motion tracking work together to keep sleep, heart rate and recovery trends more reliable.</p>"
          }
        },
        "sensing_point_2": {
          "type": "point",
          "settings": {
            "heading": "All-day continuous sensing",
            "text": "<p>No manual start or stop. xRing quietly records meaningful changes as your day unfolds.</p>"
          }
        },
        "sensing_point_3": {
          "type": "point",
          "settings": {
            "heading": "Less interruption. More insight.",
            "text": "<p>No screen, no nighttime glow. Complex data becomes body signals that are easier to understand.</p>"
          }
        }
      },
      "block_order": [
        "sensing_point_1",
        "sensing_point_2",
        "sensing_point_3"
