        },
        "comfort_point_2": {
          "type": "point",
          "settings": {
            "heading": "Smoother on the inside",
            "text": "<p>The inner surface sits closer to the finger with less bulk, so the sensors are present without feeling intrusive.</p>"
          }
        },
        "comfort_point_3": {
          "type": "point",
          "settings": {
            "heading": "Built for daily life",
            "text": "<p>Wear it through sleep, work, workouts and handwashing, so your health tracking does not keep starting over.</p>"
