    "xring_sensing": {
      "type": "xalgo-product-story",
      "blocks": {
        "sensing_point_1": {
          "type": "point",
          "settings": {
            "heading": "多传感器交叉校准",
            "text": "<p>红外、绿色 LED、体温与运动传感器协同工作，让睡眠、心率和恢复趋势更稳定。</p>"
          }
        },
        "sensing_point_2": {
          "type": "point",
          "settings": {
            "heading": "全天候连续监测",
            "text": "<p>不需要手动开始或结束，xRing 会在你的生活节奏里安静记录关键变化。</p>"
          }
        },
        "sensing_point_3": {
          "type": "point",
          "settings": {
            "heading": "少一点打扰，多一点洞察",
            "text": "<p>没有屏幕、没有夜间亮光，把复杂数据变成更容易理解的身体信号。</p>"
          }
        }
      },
      "block_order": [
        "sensing_point_1",
        "sensing_point_2",
        "sensing_point_3"
      ],
      "name": "xRing Smart Sensing",
      "settings": {
        "eyebrow": "Smart sensing",
        "heading": "更聪明的感知方式。",
        "body": "<p>xRing 的核心不是收集更多数字，而是把睡眠、心率、体温和活动变化整合成你每天能理解、能行动的健康信号。</p>",
        "callout": "<p>连续监测，不打断生活。</p>",
        "media_position": "left",
        "tone": "blush",
        "color_scheme": "scheme-1",
        "padding_top": 96,
        "padding_bottom": 96
      }
    },
    "xring_comfort": {
      "type": "xalgo-product-story",
      "blocks": {
        "comfort_point_1": {
          "type": "point",
          "settings": {
            "heading": "轻量钛金属",
            "text": "<p>坚固、轻盈、低敏，适合长时间贴肤佩戴。</p>"
          }
        },
        "comfort_point_2": {
          "type": "point",
          "settings": {
            "heading": "内侧更顺滑",
            "text": "<p>贴近手指的一面减少突兀感，让传感器存在但不抢存在感。</p>"
          }
        },
        "comfort_point_3": {
          "type": "point",
          "settings": {
            "heading": "全天候生活场景",
            "text": "<p>睡觉、办公、运动和洗手都不用频繁摘下，健康追踪才不会中断。</p>"
          }
        }
      },
      "block_order": [
        "comfort_point_1",
        "comfort_point_2",
        "comfort_point_3"
      ],
      "name": "xRing Comfort",
      "settings": {
        "eyebrow": "All-day comfort",
        "heading": "像首饰一样自然佩戴。",
        "body": "<p>智能戒指真正难的是每天都愿意戴。xRing 把重量、材质和贴肤触感放在同等重要的位置，让健康监测自然融入日常。</p>",
        "callout": "<p>健康科技不该像任务，更应该像你本来就会戴的戒指。</p>",
        "media_position": "right",
        "tone": "champagne",
        "color_scheme": "scheme-1",
        "padding_top": 96,
        "padding_bottom": 96
      }
    },
    "xring_app": {
      "type": "xalgo-product-story",
      "blocks": {
        "app_point_1": {
          "type": "point",
          "settings": {
            "heading": "睡眠与恢复",
            "text": "<p>把夜间数据转化成第二天的恢复状态，帮助你判断今天该推进还是放缓。</p>"
          }
        },
        "app_point_2": {
          "type": "point",
          "settings": {
            "heading": "压力与活动节奏",
            "text": "<p>看到哪些时段消耗最多，哪些习惯真的能让身体回到平衡。</p>"
          }
        },
        "app_point_3": {
          "type": "point",
          "settings": {
            "heading": "长期趋势",
            "text": "<p>比单日分数更重要的是趋势，xalgo App 帮你识别那些慢慢发生的变化。</p>"
          }
        }
      },
      "block_order": [
        "app_point_1",
        "app_point_2",
        "app_point_3"
      ],
      "name": "xRing App Insights",
      "settings": {
        "eyebrow": "App insights",
        "heading": "数据最后要变成建议。",
        "body": "<p>硬件负责安静记录，App 负责把复杂的生理信号翻译成清晰的日常建议。你看到的不是一堆数字，而是身体正在告诉你的方向。</p>",
        "callout": "<p>从睡眠、压力、恢复到周期趋势，一处查看。</p>",
