    "xring_comfort": {
      "type": "xalgo-product-story",
      "blocks": {
        "comfort_point_1": {
          "type": "point",
          "settings": {
            "heading": "Lightweight titanium",
            "text": "<p>Strong, light and skin-friendly, made for long hours of close contact.</p>"
