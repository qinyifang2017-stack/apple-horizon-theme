# ============================================================
# Shopify Theme 环境变量
# 复制此文件为 .env 并填入真实值
# ============================================================

# Shopify store 的 myshopify 域名（不带 https://）
SHOPIFY_FLAG_STORE=your-store.myshopify.com

# Shopify CLI 会话 token（用于 CI/CD 自动部署）
# 在 Shopify Partners 后台或通过 shopify auth 生成
SHOPIFY_FLAG_PASSWORD=

# 开发预览时使用的 store
SHOPIFY_STORE=your-store.myshopify.com
